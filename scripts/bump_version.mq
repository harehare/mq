import "json"
| import "toml"

def gradle_version(line, version):
  if (starts_with(line, "pluginVersion = ")):
    s"pluginVersion = ${version}"
  else: line
end

def npm_version(text, version):
  json::json_stringify(set(json::json_parse(text), "version", version), {indent: 2})
end

# Bumps the workspace package version and every workspace dependency that points into `crates/`.
def crates_version(text, version):
  let data = toml::toml_parse(text)
  | let workspace = data["workspace"]
  | let deps = map_values(workspace["dependencies"], fn(dep):
      if (is_dict(dep) && starts_with(get_or(dep, :path, ""), "crates/")): set(dep, "version", version) else: dep
    end)
  | let package = set(workspace["package"], "version", version)
  | toml::toml_stringify(set(data, "workspace", set(set(workspace, "package", package), "dependencies", deps)))
end

def code_block_version(line, version):
  line | .code | gsub("[0-9]+.[0-9]+.[0-9]+", version)
end
