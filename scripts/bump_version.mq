def crate_version(line):
  if (line != "[workspace.package]" && line != "[package]" && starts_with(line, "[")):
    s"
${line}"
  elif (starts_with(line, "version = ")):
    s"version = \"${version}\""
  else: line
end

def npm_version(line):
  if (starts_with(trim(line), "\"version\": ")):
    s"  \"version\": \"${version}\","
  else: line
end

def py_version(line):
  if (line != "[project]" && starts_with(line, "[")):
    s"
${line}"
  elif (starts_with(line, "version = ")):
    s"version = \"${version}\""
  else: line
end

def crates_version(line):
  if (contains(line, "path = \"crates/")):
    gsub(line, "version = \"[0-9]+.[0-9]+.[0-9]+\"", s"version = \"${version}\"")
  else: line
end

def code_block_version(line, version):
  line | .code | gsub("[0-9]+.[0-9]+.[0-9]+", version)
end
