def gradle_version(line, version):
  if (starts_with(line, "pluginVersion = ")):
    s"pluginVersion = ${version}"
  else: line
end

def npm_version(line, version):
  if (starts_with(trim(line), "\"version\": ")):
    s"  \"version\": \"${version}\","
  else: line
end

def crates_version(line, version):
  if (contains(line, "path = \"crates/")):
    gsub(line, "version = \"[0-9]+.[0-9]+.[0-9]+\"", s"version = \"${version}\"")
  elif (starts_with(line, "version = \"")):
    s"version = \"${version}\""
  else: line
end

def code_block_version(line, version):
  line | .code | gsub("[0-9]+.[0-9]+.[0-9]+", version)
end
