import "json"
| import "toml"

def gradle_version(line, version):
  if (starts_with(line, "pluginVersion = ")):
    s"pluginVersion = ${version}"
  else: line
end

def npm_version(text, version):
  var data = json::json_parse(text)
  | data["version"] = version
  | json::json_stringify(data, {indent: 2})
end

# Bumps the workspace package version and every workspace dependency that points into `crates/`.
def crates_version(text, version):
  var data = toml::toml_parse(text)
  | data["workspace"]["package"]["version"] = version
  | foreach (name, keys(data["workspace"]["dependencies"])):
      let dep = data["workspace"]["dependencies"][name]
      | if (is_dict(dep) && starts_with(get_or(dep, :path, ""), "crates/")):
          data["workspace"]["dependencies"][name]["version"] = version
    end
  | toml::toml_stringify(data)
end

def code_block_version(line, version):
  line | .code | gsub("[0-9]+.[0-9]+.[0-9]+", version)
end
