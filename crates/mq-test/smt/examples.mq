# Contracts checked by `just smt` (`mq-test --verify`). Every @ensures here holds for all inputs.
# Parameter and result types come from mq-check, so only functions whose types it settles
# (for example through `abs`, which only takes numbers) can be checked.

# @ensures(result >= 0)
# @ensures(result == x || result == -x)
def distance_from_zero(x): abs(x);

# @ensures(result >= 0)
def sum_abs(x, y): abs(x) + abs(y);

# @ensures(result >= 0)
def larger_magnitude(a, b): if (abs(a) > abs(b)): abs(a) else: abs(b);

# @ensures(result == n)
def cancels_out(n): abs(n) - abs(n) + n;
