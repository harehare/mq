# Halts execution with error code 5
#
# Returns: dynamic
def halt_error(): halt(5);

# Checks if input is an array
#
# Example:
# ```
# is_array([1, 2])
# #=> true
# ```
#
# Returns: bool
def is_array(a): type(a) == "array";

# Checks if input is markdown
#
# Example:
# ```
# is_markdown(to_h("t", 1))
# #=> true
# ```
#
# Returns: bool
def is_markdown(m): type(m) == "markdown";

# Checks if input is a boolean
#
# Example:
# ```
# is_bool(true)
# #=> true
# ```
#
# Returns: bool
def is_bool(b): type(b) == "bool";

# Checks if input is a number
#
# Example:
# ```
# is_number(1)
# #=> true
# ```
#
# Returns: bool
def is_number(n): type(n) == "number";

# Checks if input is a string
#
# Example:
# ```
# is_string("hi")
# #=> true
# ```
#
# Returns: bool
def is_string(s): type(s) == "string";

# Checks if input is None
#
# Example:
# ```
# is_none(None)
# #=> true
# ```
#
# Returns: bool
def is_none(n): type(n) == "None";

# Checks if input is a dictionary
#
# Example:
# ```
# is_dict({"a": 1})
# #=> true
# ```
#
# Returns: bool
def is_dict(d): type(d) == "dict";

# Checks if input is bytes
#
# Example:
# ```
# is_bytes(to_bytes("hi"))
# #=> true
# ```
#
# Returns: bool
def is_bytes(b): type(b) == "bytes";

# Checks if string contains a substring
#
# Example:
# ```
# contains("hello world", "world")
# #=> true
# ```
#
# Returns: bool
def contains(haystack, needle):
  if (is_dict(haystack)):
    !is_none(haystack[needle])
  else:
    index(haystack, needle) != -1
end

# Removes prefix string from input if it exists
#
# Example:
# ```
# ltrimstr("prefix_value", "prefix_")
# #=> value
# ```
#
# Returns: string
def ltrimstr(s, left):
  if (starts_with(s, left)):
    slice(s, index(s, left) + len(left), len(s))
  else:
    s
end

# Removes suffix string from input if it exists
#
# Example:
# ```
# rtrimstr("value_suffix", "_suffix")
# #=> value
# ```
#
# Returns: string
def rtrimstr(s, right):
  if (ends_with(s, right)):
    slice(s, 0, sub(len(s), len(right)))
  else:
    s
end

# Checks if string, array or dict is empty
#
# Example:
# ```
# is_empty([])
# #=> true
# ```
#
# Returns: bool
def is_empty(s):
  if (is_string(s) || is_array(s) || is_dict(s) || is_bytes(s)):
    len(s) == 0
  elif (is_none(s)):
    true
  else:
    false
end

# Tests if string matches a pattern
#
# Example:
# ```
# test("abc", "a.c")
# #=> true
# ```
#
# Returns: bool
def test(s, pattern): is_regex_match(s, pattern);

# Returns value if condition is true, None otherwise
#
# Example:
# ```
# select(5, true)
# #=> 5
# ```
#
# Returns: dynamic
def select(v, f): if (f): v;

# Returns array if input is array, None otherwise
#
# Example:
# ```
# arrays([1, 2])
# #=> [1, 2]
# ```
#
# Returns: dynamic
def arrays(a): select(a, is_array(a));

# Returns markdown if input is markdown, None otherwise
#
# Example:
# ```
# markdowns(to_h("t", 1))
# #=> # t
# ```
#
# Returns: dynamic
def markdowns(m): select(m, is_markdown(m));

# Returns boolean if input is boolean, None otherwise
#
# Example:
# ```
# booleans(true)
# #=> true
# ```
#
# Returns: dynamic
def booleans(b): select(b, is_bool(b));

# Returns number if input is number, None otherwise
#
# Example:
# ```
# numbers(1)
# #=> 1
# ```
#
# Returns: dynamic
def numbers(n): select(n, is_number(n));

# Returns string if input is string, None otherwise
#
# Example:
# ```
# strings("hi")
# #=> hi
# ```
#
# Returns: dynamic
def strings(s): select(s, is_string(s));

# Returns dict if input is dict, None otherwise
#
# Example:
# ```
# dicts({"a": 1})
# #=> {"a": 1}
# ```
#
# Returns: dynamic
def dicts(d): select(d, is_dict(d));

# Returns the value if it is None, None otherwise
#
# Example:
# ```
# nones(None)
# #=> 
# ```
#
# Returns: dynamic
def nones(n): select(n, is_none(n));

# Returns bytes if input is bytes, None otherwise
#
# Example:
# ```
# bytes(to_bytes("hi"))
# #=> 6869
# ```
#
# Returns: dynamic
def bytes(b): select(b, is_bytes(b));

# Returns the value if it is an array or dict (i.e. a container that can be iterated over), None otherwise
#
# Example:
# ```
# iterables([1, 2])
# #=> [1, 2]
# ```
#
# Returns: dynamic
def iterables(v): select(v, is_array(v) || is_dict(v));

# Returns the value if it is not an array or dict (i.e. a leaf/scalar value), None otherwise
#
# Example:
# ```
# scalars(1)
# #=> 1
# ```
#
# Returns: dynamic
def scalars(v): select(v, !(is_array(v) || is_dict(v)));

# Formats a date to ISO 8601 format (YYYY-MM-DDTHH:MM:SSZ)
#
# Example:
# ```
# to_date_iso8601(0)
# #=> 1970-01-01T00:00:00Z
# ```
#
# Returns: string
def to_date_iso8601(d): to_date(d, "%Y-%m-%dT%H:%M:%SZ");

# Applies a given function to each element of the provided array and returns a new array with the results.
#
# Example:
# ```
# map([1, 2, 3], fn(x): mul(x, 2);)
# #=> [2, 4, 6]
# ```
#
# Returns: array
def map(v, f):
  if (is_dict(v)):
    do
      let map_dict = fn(v, f): let mapped = foreach (x, entries(v)): f(x); | dict(mapped);
      | map_dict(v, f)
    end
  elif (is_none(v)):
    None
  else:
    foreach (x, v): f(x);
end

# Applies a function to each element and flattens the result into a single array
#
# Example:
# ```
# flat_map([1, 2], fn(x): [x, x];)
# #=> [1, 1, 2, 2]
# ```
#
# Returns: array
def flat_map(v, f):
  if (is_none(v)):
    None
  else:
    foreach (x, v): f(x); | flatten()
end

# Filters the elements of an array based on a provided callback function.
#
# Example:
# ```
# filter([1, 2, 3, 4], fn(x): x > 2;)
# #=> [3, 4]
# ```
#
# Returns: array
def filter(v, f):
  if (is_dict(v)):
    do
      let filter_dict = fn(v, f): let fileted = foreach (x, entries(v)): select(x, f(x)); | dict(compact(fileted));
      | filter_dict(v, f)
    end
  elif (is_none(v)):
    None
  else:
    do
      let _filter = fn(v, f): foreach (x, v): select(x, f(x)); | compact();
      | _filter(v, f)
    end
end

# Executes a provided function once for each element in an array or each key-value pair in a dictionary.
#
# Returns: dynamic
def each(v, f):
  let target = if (is_dict(v)): entries(v) else: v
  | var i = 0
  | loop:
      if (i >= len(target)): break
      | f(target[i])
      | i += 1
      | None
    end
  | v
end

# Returns the first element of an array
#
# Example:
# ```
# first([1, 2, 3])
# #=> 1
# ```
#
# Returns: dynamic
def first(arr): arr[0];

# Returns the last element of an array
#
# Example:
# ```
# last([1, 2, 3])
# #=> 3
# ```
#
# Returns: dynamic
def last(arr): arr[len(arr) - 1];

# Returns the second element of an array
#
# Example:
# ```
# second([1, 2, 3])
# #=> 2
# ```
#
# Returns: dynamic
def second(arr): if (len(arr) > 1): arr[1];

