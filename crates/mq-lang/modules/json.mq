# JSON Implementation in mq

# Parses a JSON string and returns the corresponding data structure.
#
# Example:
# ```
# import "json" | json::json_parse("{\"a\": 1}")
# #=> {"a": 1}
# ```
#
# Returns: dynamic
def json_parse(input):
  _json_parse(to_string(input))
end

# Parses a JSON string without raising on invalid input.
#
# Example:
# ```
# import "json" | json::json_try_parse("{\"a\": 1}")["ok"]
# #=> true
# ```
# Example:
# ```
# import "json" | json::json_try_parse("{bad")["ok"]
# #=> false
# ```
#
# Returns: dict
def json_try_parse(input):
  try: {ok: true, value: json_parse(input), error: None}
  catch(e): {ok: false, value: None, error: {message: e["message"]}}
end

# Serializes a value to a JSON string.
#
# Example:
# ```
# import "json" | json::json_stringify({"a": 1})
# #=> {"a": 1}
# ```
# Example:
# ```
# import "json" | json::json_stringify({"a": "he said \"hi\"\nbye"})
# #=> {"a": "he said \"hi\"\nbye"}
# ```
#
# Returns: string
def json_stringify(data):
  def _escape_control_char(code):
    if (code < 32):
      "\\u00" + slice("0123456789abcdef", code / 16, code / 16 + 1) + slice("0123456789abcdef", code % 16, code % 16 + 1)
    else:
      implode([code])
  end

  def _escape_common(str):
    replace(str, "\\", "\\\\") | replace("\"", "\\\"") | replace("\n", "\\n") | replace("\t", "\\t") | replace("\r", "\\r")
  end

  def _escape_string(str):
    let escaped = _escape_common(str)
    | if (test(escaped, "[\\x00-\\x1f]")): join(map(explode(escaped), _escape_control_char), "") else: escaped
  end

  def _format_json_stringify(data):
    "\"" + _escape_string(data) + "\""
  end

  def _json_array_stringify(data):
    "[" + join(map(data, json_stringify), ", ") + "]"
  end

  def _json_object_stringify(data):
    "{" + join(
      map(entries(data),
        fn(entry): "\"" + _escape_string(first(entry)) + "\": " + json_stringify(last(entry));), ", ") + "}"
  end

  | if (is_string(data)):
      _format_json_stringify(data)
    elif (is_number(data)):
      to_string(data)
    elif (is_bool(data)):
      to_string(data)
    elif (is_none(data)):
      "null"
    elif (is_array(data)):
      _json_array_stringify(data)
    elif (is_dict(data)):
      _json_object_stringify(data)
    else:
      to_string(data)
end

# Splits a JSON Pointer (RFC 6901) into its unescaped reference tokens.
def _pointer_tokens(pointer):
  if (pointer == ""):
    []
  elif (!starts_with(pointer, "/")):
    error("invalid JSON Pointer: " + pointer)
  else:
    map(skip(split(pointer, "/"), 1), fn(token): replace(replace(token, "~1", "/"), "~0", "~");)
end

# Converts a JSON Pointer (RFC 6901) into a path array usable with `get_path`/`set_path`/`del_path`.
# `data` is needed because a token like `"0"` is an index for an array but a key for a dict.
# Tokens under a missing value stay strings, and `-` on an array is the index one past the end.
# Raises an error for a pointer that does not start with `/` or an array token that is not an index.
#
# Example:
# ```
# import "json" | json::json_pointer_to_path({"a": [1, 2]}, "/a/1")
# #=> ["a", 1]
# ```
#
# Returns: array
def json_pointer_to_path(data, pointer):
  last(fold(_pointer_tokens(pointer), [data, []], fn(acc, token):
    let current = first(acc)
    | let key = if (is_array(current) && test(token, "^(0|[1-9][0-9]*)$")):
        to_number(token)
      elif (is_array(current) && token == "-"):
        len(current)
      elif (is_array(current)):
        error("invalid array index in JSON Pointer: " + token)
      else:
        token
    | [get(current, key), last(acc) + [key]]
  end))
end

# Converts a path array (e.g. from `paths`) into a JSON Pointer (RFC 6901), escaping `~` and `/`.
#
# Example:
# ```
# import "json" | json::json_pointer_from_path(["a/b", 0])
# #=> /a~1b/0
# ```
#
# Returns: string
def json_pointer_from_path(path):
  join(map(path, fn(key): "/" + replace(replace(to_string(key), "~", "~0"), "/", "~1");), "")
end

# Returns the value a JSON Pointer (RFC 6901) refers to, or None if it does not exist.
#
# Example:
# ```
# import "json" | json::json_pointer_get({"a": [1, 2]}, "/a/1")
# #=> 2
# ```
#
# Returns: dynamic
def json_pointer_get(data, pointer):
  get_path(data, json_pointer_to_path(data, pointer))
end

# Returns true if a JSON Pointer (RFC 6901) refers to an existing value, even if that value is None.
#
# Example:
# ```
# import "json" | json::json_pointer_has({"a": None}, "/a")
# #=> true
# ```
#
# Returns: bool
def json_pointer_has(data, pointer):
  let path = json_pointer_to_path(data, pointer)
  | if (is_empty(path)):
      true
    else:
      has(get_path(data, take(path, len(path) - 1)), last(path))
end

# Sets the value at a JSON Pointer (RFC 6901). Missing intermediate containers are created as dicts,
# and `-` appends to an array.
#
# Example:
# ```
# import "json" | json::json_pointer_set({"a": [1]}, "/a/-", 2)
# #=> {"a": [1, 2]}
# ```
#
# Returns: dynamic
def json_pointer_set(data, pointer, value):
  set_path(data, json_pointer_to_path(data, pointer), value)
end

# Deletes the value at a JSON Pointer (RFC 6901). A pointer to a missing value leaves `data` unchanged.
#
# Example:
# ```
# import "json" | json::json_pointer_del({"a": 1, "b": 2}, "/a")
# #=> {"b": 2}
# ```
#
# Returns: dynamic
def json_pointer_del(data, pointer):
  del_path(data, json_pointer_to_path(data, pointer))
end

def _diff_dict(a, b, path):
  let changed = flat_map(keys(a), fn(k):
    if (has(b, k)):
      _diff_ops(a[k], b[k], path + [k])
    else:
      [{op: "remove", path: path + [k], old: a[k]}]
  end)
  | let added = flat_map(keys(b), fn(k):
    if (has(a, k)):
      []
    else:
      [{op: "add", path: path + [k], value: b[k]}]
  end)
  | changed + added
end

def _diff_array(a, b, path):
  let na = len(a)
  | let nb = len(b)
  | let common = min(na, nb)
  | let changed = if (common == 0):
      []
    else:
      flat_map(range(0, common - 1), fn(i): _diff_ops(a[i], b[i], path + [i]) end)
  | let removed = if (na > nb):
      map(range(na - 1, nb), fn(i): {op: "remove", path: path + [i], old: a[i]} end)
    else:
      []
  | let added = if (nb > na):
      map(range(na, nb - 1), fn(i): {op: "add", path: path + [i], value: b[i]} end)
    else:
      []
  | changed + removed + added
end

def _diff_ops(a, b, path):
  if (a == b):
    []
  elif (is_dict(a) && is_dict(b)):
    _diff_dict(a, b, path)
  elif (is_array(a) && is_array(b)):
    _diff_array(a, b, path)
  else:
    [{op: "replace", path: path, value: b}]
end

def _is_key_path(path): !is_empty(path) && is_string(last(path));

# Pairs each added dict key with a removed key holding an equal value: `{moves: {add index: remove index}, used: [remove indexes]}`.
def _find_moves(ops):
  let idx = range(0, len(ops) - 1)
  | let add_idx = filter(idx, fn(i): ops[i][:op] == "add" && _is_key_path(ops[i][:path]) && !is_none(ops[i][:value]) end)
  | let rem_idx = filter(idx, fn(i): ops[i][:op] == "remove" && _is_key_path(ops[i][:path]) && !is_none(ops[i][:old]) end)
  | fold(add_idx, {moves: {}, used: []}, fn(acc, i):
    let j = first(filter(rem_idx, fn(r): !in(acc[:used], r) && ops[r][:old] == ops[i][:value] end))
    | if (is_none(j)):
        acc
      else:
        {moves: set(acc[:moves], to_string(i), j), used: acc[:used] + [j]}
  end)
end

def _finalize_ops(ops, detect_moves):
  if (is_empty(ops)):
    []
  else:
    do
      let plan = if (detect_moves):
          _find_moves(ops)
        else:
          {moves: {}, used: []}
      | flat_map(range(0, len(ops) - 1), fn(i):
        let op = ops[i]
        | if (in(plan[:used], i)):
            []
          elif (has(plan[:moves], to_string(i))):
            [{op: "move", from: json_pointer_from_path(ops[plan[:moves][to_string(i)]][:path]), path: json_pointer_from_path(op[:path])}]
          elif (op[:op] == "remove"):
            [{op: "remove", path: json_pointer_from_path(op[:path])}]
          else:
            [{op: op[:op], path: json_pointer_from_path(op[:path]), value: op[:value]}]
      end)
    end
end

# Returns the JSON Patch (RFC 6902) that turns `a` into `b`. Dicts are compared by key and arrays by index.
# A key removed in one place and added elsewhere with an equal value becomes a `move`; pass `{moves: false}` to disable that.
#
# Example:
# ```
# import "json" | json::json_diff({"a": 1, "b": 2}, {"a": 1, "b": 3})
# #=> [{"op": "replace", "path": "/b", "value": 3}]
# ```
#
# Returns: array
def json_diff(a, b, options = {}):
  _finalize_ops(_diff_ops(a, b, []), get_or(options, :moves, true))
end

def _patch_fail(op, message):
  error("json_patch: " + to_string(get_or(op, "op", "?")) + " " + to_string(get_or(op, "path", "")) + ": " + message)
end

def _patch_add(doc, path, value):
  if (is_empty(path)):
    value
  else:
    let parent_path = take(path, len(path) - 1)
    | let key = last(path)
    | let parent = get_path(doc, parent_path)
    | if (is_array(parent)):
        if (!is_number(key) || key < 0 || key > len(parent)):
          error("json_patch: array index out of range")
        elif (is_empty(parent_path)):
          take(parent, key) + [value] + skip(parent, key)
        else:
          set_path(doc, parent_path, take(parent, key) + [value] + skip(parent, key))
      elif (is_dict(parent)):
        set_path(doc, path, value)
      else:
        error("json_patch: the parent of the target is not an object or array")
end

def _patch_move_copy(doc, op, kind, pointer):
  let src = get_or(op, "from", None)
  | if (is_none(src) || !json_pointer_has(doc, src)):
      _patch_fail(op, "\"from\" does not exist")
    elif (kind == "move" && pointer == src):
      doc
    elif (kind == "move" && starts_with(pointer, src + "/")):
      _patch_fail(op, "cannot move a value into itself")
    elif (kind == "copy"):
      _patch_add(doc, json_pointer_to_path(doc, pointer), json_pointer_get(doc, src))
    else:
      do
        let removed = json_pointer_del(doc, src)
        | _patch_add(removed, json_pointer_to_path(removed, pointer), json_pointer_get(doc, src))
      end
end

def _apply_op(doc, op):
  let kind = get_or(op, "op", None)
  | let pointer = get_or(op, "path", None)
  | if (is_none(kind) || is_none(pointer)):
      error("json_patch: every operation needs \"op\" and \"path\"")
    elif (kind == "add"):
      if (!has(op, "value")):
        _patch_fail(op, "missing \"value\"")
      else:
        _patch_add(doc, json_pointer_to_path(doc, pointer), op["value"])
    elif (kind == "remove"):
      if (pointer == "" || !json_pointer_has(doc, pointer)):
        _patch_fail(op, "path does not exist")
      else:
        json_pointer_del(doc, pointer)
    elif (kind == "replace"):
      if (!has(op, "value") || !json_pointer_has(doc, pointer)):
        _patch_fail(op, "path does not exist or \"value\" is missing")
      elif (pointer == ""):
        op["value"]
      else:
        json_pointer_set(doc, pointer, op["value"])
    elif (kind == "move" || kind == "copy"):
      _patch_move_copy(doc, op, kind, pointer)
    elif (kind == "test"):
      if (!has(op, "value") || !json_pointer_has(doc, pointer) || json_pointer_get(doc, pointer) != op["value"]):
        _patch_fail(op, "test failed")
      else:
        doc
    else:
      _patch_fail(op, "unknown operation")
end

# Applies a JSON Patch (RFC 6902: add, remove, replace, move, copy, test) to `doc` and returns the result.
# Raises an error, leaving `doc` untouched, if an operation cannot be applied.
#
# Example:
# ```
# import "json" | json::json_patch({"a": [1, 3]}, [{"op": "add", "path": "/a/1", "value": 2}])
# #=> {"a": [1, 2, 3]}
# ```
#
# Returns: dynamic
def json_patch(doc, ops):
  if (!is_array(ops)):
    error("json_patch: the patch must be an array of operations")
  else:
    fold(ops, doc, fn(acc, op): _apply_op(acc, op) end)
end

# Applies a JSON Merge Patch (RFC 7396) to `doc` and returns the result. Unlike `json_patch`,
# a merge patch is itself a JSON value: a `null` member removes the matching key, an object
# member merges recursively, and any other value (including an array) replaces it wholesale.
# If `patch` is not a dict, it replaces `doc` entirely (this is how a merge patch clears or
# replaces a non-dict value).
#
# Example:
# ```
# import "json" | json::json_merge_patch({"a": 1, "b": {"c": 2, "d": 3}}, {"a": None, "b": {"c": 9}})
# #=> {"b": {"c": 9, "d": 3}}
# ```
#
# Returns: dynamic
def json_merge_patch(doc, patch):
  if (!is_dict(patch)):
    patch
  else:
    do
      let base = if (is_dict(doc)): doc else: {}
      | fold(keys(patch), base, fn(acc, k):
        let v = patch[k]
        | if (is_none(v)):
            if (has(acc, k)): del(acc, k) else: acc
          else:
            set(acc, k, json_merge_patch(get_or(acc, k, None), v))
      end)
    end
end

# 3-way merges `ours` and `theirs` against their common `base`. Returns `{value, conflicts}`:
# `value` is the merged result (favoring `ours` at any conflicting leaf or deletion-vs-edit
# clash), and `conflicts` lists every path where both sides changed the same leaf to different
# values, as `{path, base, ours, theirs}` (a JSON Pointer `path`; `ours`/`theirs` is `None` when
# that side deleted the key, which is indistinguishable from a genuine `null` value there). Two
# sides editing the same nested dict key-by-key merges recursively; anything else (arrays,
# scalars, one side turning a dict into something else) is compared as a whole leaf.
#
# Example:
# ```
# import "json" | json::merge3({"a": 1, "b": 1}, {"a": 2, "b": 1}, {"a": 1, "b": 3})
# #=> {"value": {"a": 2, "b": 3}, "conflicts": []}
# ```
#
# Returns: dict
def merge3(base, ours, theirs):
  _merge3_at(base, ours, theirs, [])
end

def _merge3_at(base, ours, theirs, path):
  if (ours == theirs):
    {value: ours, conflicts: []}
  elif (is_dict(ours) && is_dict(theirs)):
    _merge3_dict(if (is_dict(base)): base else: {}, ours, theirs, path)
  elif (ours == base):
    {value: theirs, conflicts: []}
  elif (theirs == base):
    {value: ours, conflicts: []}
  else:
    {value: ours, conflicts: [{path: json_pointer_from_path(path), base: base, ours: ours, theirs: theirs}]}
end

def _merge3_dict(base, ours, theirs, path):
  fold(uniq(keys(base) + keys(ours) + keys(theirs)), {value: {}, conflicts: []}, fn(acc, k):
    let hb = has(base, k)
    | let ho = has(ours, k)
    | let ht = has(theirs, k)
    | let bv = get_or(base, k, None)
    | let ov = get_or(ours, k, None)
    | let tv = get_or(theirs, k, None)
    | if (!ho && !ht):
        acc
      elif (ho && !ht):
        if (!hb):
          {value: set(acc[:value], k, ov), conflicts: acc[:conflicts]}
        elif (ov == bv):
          acc
        else:
          {value: set(acc[:value], k, ov), conflicts: acc[:conflicts] + [{path: json_pointer_from_path(path + [k]), base: bv, ours: ov, theirs: None}]}
      elif (!ho && ht):
        if (!hb):
          {value: set(acc[:value], k, tv), conflicts: acc[:conflicts]}
        elif (tv == bv):
          acc
        else:
          {value: acc[:value], conflicts: acc[:conflicts] + [{path: json_pointer_from_path(path + [k]), base: bv, ours: None, theirs: tv}]}
      else:
        do
          let sub = _merge3_at(bv, ov, tv, path + [k])
          | {value: set(acc[:value], k, sub[:value]), conflicts: acc[:conflicts] + sub[:conflicts]}
        end
  end)
end

# Converts a JSON data structure to a Markdown table.
#
# Example:
# ```
# import "json" | json::json_to_markdown_table([{"a": 1, "b": 2}])
# #=> | a | b |
# | --- | --- |
# | 1 | 2 |
# ```
#
# Returns: string
def json_to_markdown_table(data):
  def _create_array_markdown_table(data):
    let headers = keys(first(data))
    | let header_row = "| " + join(headers, " | ") + " |"
    | let separator_row = "| " + join(map(headers, fn(_): "---";), " | ") + " |"
    | let data_rows = map(data, fn(row):
          "| " + join(map(headers, fn(header): if (is_none(row[header])): "" else: replace(to_string(row[header]), "\n", "\\n");), " | ") + " |"
        end)
    | [header_row, separator_row] + data_rows
    | join("\n")
  end

  def _create_dict_markdown_table(data):
    let headers = ["Key", "Value"]
    | let header_row = "| " + join(headers, " | ") + " |"
    | let separator_row = "| " + join(map(headers, fn(_): "---";), " | ") + " |"
    | let data_rows = map(keys(data), fn(key):
          "| " + key + " | " + (if (is_none(data[key])): "" else: replace(to_string(data[key]), "\n", "\\n")) + " |"
        end)
    | [header_row, separator_row] + data_rows
    | join("\n")
  end

  def _create_simple_markdown_table(data):
    "| Value |\n| --- |\n| " + to_string(data) + " |"
  end

  | if (is_array(data)):
      _create_array_markdown_table(data)
    elif (is_dict(data)):
      _create_dict_markdown_table(data)
    else:
      _create_simple_markdown_table(data)
end

# Converts a data structure to a JSON front matter string, delimited with
# `;;;` (the convention used by e.g. Hexo). Unlike YAML (`---`) and TOML
# (`+++`) front matter, mq's Markdown parser does not recognize `;;;` blocks
# as a distinct front matter node, so this output won't round-trip through
# `frontmatter`/`is_yaml`/`is_toml`-style selectors — it's meant for
# generating files for tools that do support this convention.
#
# Example:
# ```
# import "json" | json::to_frontmatter({"key": 1})
# #=> ;;;
# {"key": 1}
# ;;;
# ```
#
# Returns: string
def to_frontmatter(data):
  ";;;\n" + json_stringify(data) + "\n;;;"
end
