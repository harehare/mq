import "md"
| include "test"

# -- Markdown Builder (md) Tests --

def test_md_h():
  let result = to_string(md::h("Title", 2))
  | assert_eq(result, "## Title")
end

def test_md_code():
  let result = to_string(md::code("let x = 1;", "rust"))
  | assert_eq(result, "```rust\nlet x = 1;\n```")
end

def test_md_code_inline():
  let result = to_string(md::code_inline("x"))
  | assert_eq(result, "`x`")
end

def test_md_text():
  let result = to_string(md::text("plain"))
  | assert_eq(result, "plain")
end

def test_md_strong():
  let result = to_string(md::strong("bold"))
  | assert_eq(result, "**bold**")
end

def test_md_em():
  let result = to_string(md::em("italic"))
  | assert_eq(result, "*italic*")
end

def test_md_delete():
  let result = to_string(md::delete("gone"))
  | assert_eq(result, "~~gone~~")
end

def test_md_h1_to_h6():
  assert_eq(to_string(md::h1("T")), "# T")
  | assert_eq(to_string(md::h2("T")), "## T")
  | assert_eq(to_string(md::h3("T")), "### T")
  | assert_eq(to_string(md::h4("T")), "#### T")
  | assert_eq(to_string(md::h5("T")), "##### T")
  | assert_eq(to_string(md::h6("T")), "###### T")
end

def test_md_highlight():
  assert_eq(to_string(md::highlight("key")), "==key==")
end

def test_md_comment():
  assert_eq(to_string(md::comment("todo")), "<!-- todo -->")
end

def test_md_wikilink():
  assert_eq(to_string(md::wikilink("Page")), "[[Page]]")
  | assert_eq(to_string(md::wikilink("Page", "alias")), "[[Page|alias]]")
  | assert_eq(to_md_name(md::wikilink("Page")), "wikilink")
end

def test_md_embed():
  assert_eq(to_string(md::embed("a.png")), "![[a.png]]")
  | assert_eq(to_string(md::embed("a.png", "cap")), "![[a.png|cap]]")
  | assert_eq(to_md_name(md::embed("a.png")), "embed")
end

def test_md_escape():
  assert_eq(to_string(md::escape("a*b_c[d]#")), "a\\*b\\_c\\[d\\]\\#")
  | assert_eq(to_string(md::escape("plain")), "plain")
end

def test_md_hard_break():
  assert_eq(to_string(md::hard_break("a\nb\n\nc\nd")), "a  \nb\n\nc  \nd")
  | assert_eq(to_string(md::hard_break("single")), "single")
end

def test_md_blockquote():
  let result = to_string(md::blockquote("quote"))
  | assert_eq(result, "> quote")
end

# @parametrize([
#   ["note body", "note", "", "> [!NOTE]\n> note body"],
#   ["warn body", "warning", "Careful", "> [!WARNING] Careful\n> warn body"],
# ])
def test_md_callout(value, kind, title, expected):
  let result = to_string(md::callout(value, kind, title))
  | assert_eq(result, expected)
end

def test_md_hr():
  let result = to_string(md::hr())
  | assert_eq(result, "***")
end

def test_md_math():
  let result = to_string(md::math("E=mc^2"))
  | assert_eq(result, "$$\nE=mc^2\n$$")
end

def test_md_math_inline():
  let result = to_string(md::math_inline("x^2"))
  | assert_eq(result, "$x^2$")
end

def test_md_link():
  let result = to_string(md::link("https://example.com", "Example"))
  | assert_eq(result, "[Example](https://example.com)")
end

def test_md_image():
  let result = to_string(md::image("https://example.com/a.png", "Alt"))
  | assert_eq(result, "![Alt](https://example.com/a.png \"\")")
end

# @parametrize([
#   ["Item", 0, false, None, "- Item"],
#   ["Nested", 1, false, None, "  - Nested"],
#   ["Ordered", 0, true, None, "1. Ordered"],
#   ["Checked", 0, false, true, "- [x] Checked"],
# ])
def test_md_list(value, level, ordered, checked, expected):
  let result = to_string(md::list(value, level, ordered, checked))
  | assert_eq(result, expected)
end

def test_md_table_row():
  let result = to_string(md::table_row(["A", "B"]))
  | assert_eq(result, "|A|B|")
end

def test_md_table_cell():
  let result = md::table_cell("v", 1, 2)
  | assert_eq(to_string(result), "v")
  | assert_eq(result.row, 1)
  | assert_eq(result.column, 2)
end

def test_md_table_align():
  let result = to_string(md::table_align(["left", "right"]))
  | assert_eq(result, "|:---|---:|")
end

def test_md_footnote():
  let result = to_string(md::footnote("Footnote text", "1"))
  | assert_eq(result, "[^1]: Footnote text")
end

def test_md_footnote_ref():
  let result = to_string(md::footnote_ref("1"))
  | assert_eq(result, "[^1]")
end

def test_md_definition():
  let result = to_string(md::definition("https://example.com", "ex", ""))
  | assert_eq(result, "[ex]: https://example.com")
end

def test_md_definition_with_title():
  let result = to_string(md::definition("https://example.com", "ex", "Example"))
  | assert_eq(result, "[ex]: https://example.com \"Example\"")
end

def test_md_html():
  let result = to_string(md::html("<br>"))
  | assert_eq(result, "<br>")
end

def test_md_linebreak():
  let result = to_string(md::linebreak())
  | assert_eq(result, "\\\n")
end

def test_md_table():
  let result = to_string(md::doc(md::table(["A", "B"], [["1", "2"], ["3", "4"]])))
  | assert_eq(result, "|A|B|\n|---|---|\n|1|2|\n|3|4|")
end

def test_md_table_with_aligns():
  let result = to_string(md::doc(md::table(["A", "B"], [["1", "2"]], ["left", "right"])))
  | assert_eq(result, "|A|B|\n|:---|---:|\n|1|2|")
end

def test_md_doc():
  let result = to_string(md::doc(md::text("a"), md::text("b")))
  | assert_eq(result, "a\nb")
end

def test_md_doc_array_arg():
  let result = to_string(md::doc([md::text("a"), md::text("b")]))
  | assert_eq(result, "a\nb")
end

def test_md_doc_flattens_nested_arrays():
  let result = to_string(md::doc(
    md::h("Items", 2),
    map(["a", "b"], fn(x): md::list(x);),
  ))
  | assert_eq(result, "## Items\n- a\n- b")
end

def test_md_doc_skips_none_children():
  let result = to_string(md::doc(md::text("a"), None, md::text("b")))
  | assert_eq(result, "a\n\nb")
end

# -- Reference indexing/resolution (md::reference_index / md::resolve_references) --

def test_md_reference_index_link():
  let idx = md::reference_index(to_markdown("[a][b]\n\n[b]: https://example.com \"B\""))
  | let entries = idx[:links]["b"]
  | assert_eq(len(entries), 1)
  | assert_eq(entries[0][:ident], "b")
  | assert_eq(entries[0][:url], "https://example.com")
  | assert_eq(entries[0][:title], "B")
end

def test_md_reference_index_footnote():
  let idx = md::reference_index(to_markdown("note[^1]\n\n[^1]: Body."))
  | let entries = idx[:footnotes]["1"]
  | assert_eq(len(entries), 1)
  | assert_eq(entries[0][:ident], "1")
end

def test_md_reference_index_duplicate_link_definitions():
  let idx = md::reference_index(to_markdown("[a][b]\n\n[b]: https://x.com\n[b]: https://y.com"))
  | assert_eq(len(idx[:links]["b"]), 2)
end

def test_md_reference_index_missing_ident_is_empty():
  let idx = md::reference_index(to_markdown("[a][b]\n\n[b]: https://example.com"))
  | assert_eq(get_or(idx[:links], "missing", []), [])
end

def test_md_reference_index_ignores_single_node_input_with_warning():
  let idx = md::reference_index(first(to_markdown("[a][b]\n\n[b]: https://example.com")))
  | assert_eq(is_dict(idx), true)
end

def test_md_resolve_references_link():
  let refs = md::resolve_references(to_markdown("[a][b]\n\n[b]: https://example.com"))
  | assert_eq(len(refs), 1)
  | let r = first(refs)
  | assert_eq(r[:type], "link_ref")
  | assert_eq(r[:ident], "b")
  | assert_eq(r[:resolved], true)
  | assert_eq(r[:duplicate], false)
  | assert_eq(r[:definition][:url], "https://example.com")
end

def test_md_resolve_references_shortcut_link():
  let refs = md::resolve_references(to_markdown("See [shortcut] here.\n\n[shortcut]: https://example.com"))
  | assert_eq(first(refs)[:ident], "shortcut")
  | assert_eq(first(refs)[:resolved], true)
end

def test_md_resolve_references_image():
  let refs = md::resolve_references(to_markdown("![alt][img]\n\n[img]: https://example.com/a.png"))
  | assert_eq(first(refs)[:type], "image_ref")
  | assert_eq(first(refs)[:resolved], true)
end

def test_md_resolve_references_footnote():
  let refs = md::resolve_references(to_markdown("note[^1]\n\n[^1]: Body."))
  | assert_eq(first(refs)[:type], "footnoteref")
  | assert_eq(first(refs)[:resolved], true)
end

def test_md_resolve_references_duplicate_definition_picks_first():
  let refs = md::resolve_references(to_markdown("[a][b]\n\n[b]: https://x.com\n[b]: https://y.com"))
  | let r = first(refs)
  | assert_eq(r[:duplicate], true)
  | assert_eq(r[:definition][:url], "https://x.com")
  | assert_eq(len(r[:definitions]), 2)
end

def test_md_resolve_references_unresolved_against_explicit_index():
  let refs = md::resolve_references(to_markdown("[a][b]\n\n[b]: https://example.com"), dict())
  | let r = first(refs)
  | assert_eq(r[:resolved], false)
  | assert_eq(r[:definition], None)
  | assert_eq(r[:definitions], [])
end

def test_md_resolve_references_resolves_against_index_from_other_nodes():
  let whole_doc = to_markdown("[a][b]\n\n[b]: https://example.com")
  | let idx = md::reference_index(whole_doc)
  | let refs_only = filter(whole_doc, fn(n): to_md_name(n) == "link_ref";)
  | let r = first(md::resolve_references(refs_only, idx))
  | assert_eq(r[:resolved], true)
  | assert_eq(r[:definition][:url], "https://example.com")
end

# @parametrize([["1. a"], ["12) a"], ["- a"], ["+ a"], ["---"], ["==="], ["a\n---"], ["x\n- y"]])
def test_md_escape_keeps_line_start_syntax_literal(value):
  let names = map(flatten([to_markdown(to_markdown_string(md::text(md::escape(value))))]), to_md_name)
  | assert_true(all(names, fn(n): n == "text";))
end

def test_md_escape_leaves_plain_text_alone():
  assert_eq(map(["a - b", "1.5", "-x", "a 1. b"], fn(v): to_string(md::escape(v));), ["a - b", "1.5", "-x", "a 1. b"])
end

# Escaped text must still parse as plain text, whatever syntax its tokens would form at a line start.
# @small_scope(3, [enumerate::array_of(enumerate::element(["-", "+", "1.", "2)", "---", "===", ">", "#", "*", "a"]), 1, 3), enumerate::element([" ", "\n"])])
def test_md_escape_always_parses_as_plain_text(tokens, separator):
  let value = join(tokens, separator)
  | let names = map(flatten([to_markdown(to_markdown_string(md::text(md::escape(value))))]), to_md_name)
  | assert_true(all(names, fn(n): n == "text";))
end

def test_md_link_and_image_accept_nodes_as_text():
  assert_eq(
    map([md::link("u", md::strong("a")), md::image("u", md::text("alt"))], to_string),
    ["[**a**](u)", "![alt](u \"\")"]
  )
end

def _mb_parsed(node): let d = to_markdown(to_markdown_string(node)) | if (is_array(d)): d else: [d];
def _mb_names(node): map(_mb_parsed(node), to_md_name);

# Builder output must parse back into the node it was built as, even for awkward text.
# @small_scope(0, [enumerate::element(["a", "a*b", "a_b", "a`b", "#a", "a|b", "a[b]", "<a>", "a\\b", "a~b", "1. a", "- a", "> a", " a", "a "]), enumerate::element([1, 2, 3, 4, 5, 6])])
def test_md_heading_roundtrips(value, depth):
  let parsed = _mb_parsed(md::h(md::escape(value), depth))
  | assert_eq([len(parsed), to_md_name(parsed[0]), parsed[0].depth], [1, "h" + to_string(depth), depth])
end

# @small_scope(0, [enumerate::element(["a", "a*b", "a_b", "a`b", "#a", "a|b", "a[b]", "<a>", "a\\b", "1. a", "- a", "> a"])])
def test_md_inline_wrappers_roundtrip(value):
  let escaped = md::escape(value)
  | assert_eq(
      [_mb_names(md::strong(escaped)), _mb_names(md::em(escaped)), _mb_names(md::delete(escaped))],
      [_mb_names(md::strong("a")), _mb_names(md::em("a")), _mb_names(md::delete("a"))]
    )
end

# @small_scope(0, [enumerate::element(["https://e.com", "https://e.com/a b", "https://e.com/(x)", "u", "https://e.com/a)b"]), enumerate::element(["a", "a*b", "a]b", "a[b"]), enumerate::element(["", "t", "t\"q"])])
def test_md_link_roundtrips(url, text, title):
  let link = first(_mb_parsed(md::link(url, md::escape(text), title)))
  | assert_eq([to_md_name(link), link.url, link.title], ["link", url, if (title == ""): None else: title])
end

# @small_scope(0, [enumerate::element(["https://e.com/a.png", "u"]), enumerate::element(["a", "a*b", "a]b"]), enumerate::element(["", "t"])])
def test_md_image_roundtrips(url, alt, title):
  let image = first(_mb_parsed(md::image(url, alt, title)))
  | assert_eq([to_md_name(image), image.url, image.alt], ["image", url, alt])
end

# @small_scope(0, [enumerate::element(["a", "a*b", "1. a", "- a", "a|b"]), enumerate::element([0, 1, 2]), enumerate::element([true, false])])
def test_md_list_item_roundtrips(value, level, ordered):
  let parsed = _mb_parsed(md::list(md::escape(value), level, ordered))
  | let item = first(parsed)
  | assert_eq([len(parsed), to_md_name(item), item.ordered], [1, "list", ordered])
end

# @small_scope(0, [enumerate::element(["a", "a*b", "a|b", "a\\b"]), enumerate::element(["a", "b|c"])])
def test_md_table_roundtrips(header, cell):
  assert_eq(
    _mb_names(md::table([md::escape(header)], [[md::escape(cell)]])),
    _mb_names(md::table(["a"], [["a"]]))
  )
end
