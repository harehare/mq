import "json"
| import "gen"
| include "test"

# -- JSON Tests --

| let json_input = "{\"users\":[{\"id\":1,\"name\":\"Alice\",\"email\":\"alice@example.com\",\"roles\":[\"admin\",\"user\"]},{\"id\":2,\"name\":\"Bob\",\"email\":\"bob@example.com\",\"roles\":[\"user\"]},{\"id\":3,\"name\":\"Charlie\",\"email\":\"charlie@example.com\",\"roles\":[\"editor\",\"user\"]}],\"meta\":{\"count\":3,\"generated_at\":\"2024-06-01T12:00:00Z\"}}" |

def test_json_parse():
  let result = json::json_parse(json_input)
  | assert_eq(len(result["users"]), 3)
end

def test_json_stringify():
  let result = json::json_stringify(json::json_parse(json_input))
  | assert_snapshot("json_stringify", result)
end

def test_json_stringify_escapes_special_characters():
  let original = {"a": "he said \"hi\"\nline2\tend\\slash"}
  | let result = json::json_stringify(original)
  | assert_eq(json::json_parse(result), original)
end

# @parametrize([["a\u0001b"], ["cr\rlf"], ["\u001f"], ["\u0000"], ["mix\u0002\n\t\"\\é😀"]])
def test_json_stringify_escapes_control_characters(s):
  let result = json::json_stringify({"k\u0001": s})
  | assert(!test(result, "[\\x00-\\x1f]"))
  | assert_eq(json::json_parse(result), {"k\u0001": s})
end

def test_json_stringify_escapes_key():
  let original = {"a\"b": 1}
  | let result = json::json_stringify(original)
  | assert_eq(json::json_parse(result), original)
end

def test_json_to_markdown_table():
  let result = json::json_parse(json_input)
  | let result = json::json_to_markdown_table(result["users"])
  | assert_snapshot("json_to_markdown_table", result)
end

# @parametrize([[{"title": "title", "draft": false}], [{}], [{"tags": ["a", "b"]}]])
def test_json_to_frontmatter(input):
  let result = json::to_frontmatter(input)
  | assert(starts_with(result, ";;;\n"))
  | assert(ends_with(result, "\n;;;"))
  | let body = result[4:len(result) - 4]
  | assert_eq(json::json_parse(body), input)
end

# @property(100, [gen::string("abc XYZ012\"\\\n\t", 10), gen::int(-1000000, 1000000), gen::bool(), gen::array(gen::int(-100, 100), 4)])
def test_json_parse_stringify_round_trip(s, n, b, arr):
  let data = {"s": s, "n": n, "b": b, "arr": arr, "nested": {"x": n, "y": b, "z": s}}
  | assert_eq(json::json_parse(json::json_stringify(data)), data)
end

# -- JSON Pointer Tests --

| let pointer_doc = {"foo": ["bar", "baz"], "": 0, "a/b": 1, "c%d": 2, "e^f": 3, "g|h": 4, "i\\j": 5, "k\"l": 6, " ": 7, "m~n": 8, "0": "zero"} |

# RFC 6901 section 5 examples.
# @parametrize([["", pointer_doc], ["/foo", ["bar", "baz"]], ["/foo/0", "bar"], ["/foo/1", "baz"], ["/", 0], ["/a~1b", 1], ["/c%d", 2], ["/e^f", 3], ["/g|h", 4], ["/i\\j", 5], ["/k\"l", 6], ["/ ", 7], ["/m~0n", 8]])
def test_json_pointer_get(pointer, expected):
  assert_eq(json::json_pointer_get(pointer_doc, pointer), expected)
end

def test_json_pointer_get_prefers_dict_key_over_index():
  assert_eq(json::json_pointer_get(pointer_doc, "/0"), "zero")
end

# @parametrize([["/foo/2"], ["/nope"], ["/nope/x"], ["/foo/-"]])
def test_json_pointer_get_missing(pointer):
  assert_none(json::json_pointer_get(pointer_doc, pointer))
end

# @parametrize([["foo"], ["#/foo"], [" /foo"], ["/foo/01"], ["/foo/bar"], ["/foo/+1"]])
def test_json_pointer_get_invalid(pointer):
  assert_eq(try: json::json_pointer_get(pointer_doc, pointer) catch: "error", "error")
end

def test_json_pointer_to_path():
  assert_eq(json::json_pointer_to_path(pointer_doc, "/foo/1"), ["foo", 1])
  | assert_eq(json::json_pointer_to_path(pointer_doc, ""), [])
  | assert_eq(json::json_pointer_to_path(pointer_doc, "/a~1b"), ["a/b"])
  | assert_eq(json::json_pointer_to_path(pointer_doc, "/foo/-"), ["foo", 2])
  | assert_eq(json::json_pointer_to_path({}, "/a/0"), ["a", "0"])
end

# @parametrize([[[], ""], [["foo", 0], "/foo/0"], [["a/b"], "/a~1b"], [["m~n"], "/m~0n"], [["~1"], "/~01"], [[""], "/"]])
def test_json_pointer_from_path(path, expected):
  assert_eq(json::json_pointer_from_path(path), expected)
end

def test_json_pointer_from_path_round_trips_paths():
  let doc = {"a/b": [1, {"~": 2}], "": 3, "0": 4}
  | let pointers = map(paths(doc), json::json_pointer_from_path)
  | assert_eq(map(pointers, fn(p): json::json_pointer_get(doc, p);), [1, 2, 3, 4])
end

def test_json_pointer_has():
  let doc = {"a": None, "b": [1]}
  | assert(json::json_pointer_has(doc, ""))
  | assert(json::json_pointer_has(doc, "/a"))
  | assert(json::json_pointer_has(doc, "/b/0"))
  | assert(!json::json_pointer_has(doc, "/b/1"))
  | assert(!json::json_pointer_has(doc, "/c"))
  | assert(!json::json_pointer_has(doc, "/c/d"))
end

# @parametrize([["/a", 9, {"a": 9, "b": [1, 2]}], ["/b/1", 9, {"a": 1, "b": [1, 9]}], ["/b/-", 9, {"a": 1, "b": [1, 2, 9]}], ["/c/d", 9, {"a": 1, "b": [1, 2], "c": {"d": 9}}], ["", 9, 9]])
def test_json_pointer_set(pointer, value, expected):
  assert_eq(json::json_pointer_set({"a": 1, "b": [1, 2]}, pointer, value), expected)
end

# @parametrize([["/a", {"b": [1, 2]}], ["/b/0", {"a": 1, "b": [2]}], ["/c", {"a": 1, "b": [1, 2]}], ["/c/d", {"a": 1, "b": [1, 2]}], ["", None]])
def test_json_pointer_del(pointer, expected):
  assert_eq(json::json_pointer_del({"a": 1, "b": [1, 2]}, pointer), expected)
end
