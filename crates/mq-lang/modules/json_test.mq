import "json"
| import "gen"
| include "test"

# -- JSON Tests --

| let json_input = "{\"users\":[{\"id\":1,\"name\":\"Alice\",\"email\":\"alice@example.com\",\"roles\":[\"admin\",\"user\"]},{\"id\":2,\"name\":\"Bob\",\"email\":\"bob@example.com\",\"roles\":[\"user\"]},{\"id\":3,\"name\":\"Charlie\",\"email\":\"charlie@example.com\",\"roles\":[\"editor\",\"user\"]}],\"meta\":{\"count\":3,\"generated_at\":\"2024-06-01T12:00:00Z\"}}" |

def test_json_parse():
  let result = json::json_parse(json_input)
  | assert_eq(len(result["users"]), 3)
end

def test_json_try_parse_ok():
  let result = json::json_try_parse("{\"a\": 1}")
  | assert_eq(result["ok"], true)
  | assert_eq(result["value"], {"a": 1})
  | assert_eq(result["error"], None)
end

def test_json_try_parse_error():
  let result = json::json_try_parse("{bad")
  | assert_eq(result["ok"], false)
  | assert_eq(result["value"], None)
  | assert_eq(is_string(result["error"]["message"]), true)
end

def test_json_stringify():
  let result = json::json_stringify(json::json_parse(json_input))
  | assert_snapshot("json_stringify", result)
end

def test_json_stringify_escapes_special_characters():
  let original = {"a": "he said \"hi\"\nline2\tend\\slash"}
  | let result = json::json_stringify(original)
  | assert_eq(json::json_parse(result), original)
end

# @parametrize([["a\u0001b"], ["cr\rlf"], ["\u001f"], ["\u0000"], ["mix\u0002\n\t\"\\é😀"]])
def test_json_stringify_escapes_control_characters(s):
  let result = json::json_stringify({"k\x01": s})
  | assert(!test(result, "[\\x00-\\x1f]"))
  | assert_eq(json::json_parse(result), {"k\x01": s})
end

def test_json_stringify_escapes_key():
  let original = {"a\"b": 1}
  | let result = json::json_stringify(original)
  | assert_eq(json::json_parse(result), original)
end

def test_json_to_markdown_table():
  let result = json::json_parse(json_input)
  | let result = json::json_to_markdown_table(result["users"])
  | assert_snapshot("json_to_markdown_table", result)
end

# @parametrize([[{"title": "title", "draft": false}], [{}], [{"tags": ["a", "b"]}]])
def test_json_to_frontmatter(input):
  let result = json::to_frontmatter(input)
  | assert(starts_with(result, ";;;\n"))
  | assert(ends_with(result, "\n;;;"))
  | let body = result[4:len(result) - 4]
  | assert_eq(json::json_parse(body), input)
end

# @property(100, [gen::string("abc XYZ012\"\\\n\t", 10), gen::int(-1000000, 1000000), gen::bool(), gen::array(gen::int(-100, 100), 4)])
def test_json_parse_stringify_round_trip(s, n, b, arr):
  let data = {"s": s, "n": n, "b": b, "arr": arr, "nested": {"x": n, "y": b, "z": s}}
  | assert_eq(json::json_parse(json::json_stringify(data)), data)
end

# -- JSON Pointer Tests --

| let pointer_doc = {"foo": ["bar", "baz"], "": 0, "a/b": 1, "c%d": 2, "e^f": 3, "g|h": 4, "i\\j": 5, "k\"l": 6, " ": 7, "m~n": 8, "0": "zero"} |

# RFC 6901 section 5 examples.
# @parametrize([["", pointer_doc], ["/foo", ["bar", "baz"]], ["/foo/0", "bar"], ["/foo/1", "baz"], ["/", 0], ["/a~1b", 1], ["/c%d", 2], ["/e^f", 3], ["/g|h", 4], ["/i\\j", 5], ["/k\"l", 6], ["/ ", 7], ["/m~0n", 8]])
def test_json_pointer_get(pointer, expected):
  assert_eq(json::json_pointer_get(pointer_doc, pointer), expected)
end

def test_json_pointer_get_prefers_dict_key_over_index():
  assert_eq(json::json_pointer_get(pointer_doc, "/0"), "zero")
end

# @parametrize([["/foo/2"], ["/nope"], ["/nope/x"], ["/foo/-"]])
def test_json_pointer_get_missing(pointer):
  assert_none(json::json_pointer_get(pointer_doc, pointer))
end

# @parametrize([["foo"], ["#/foo"], [" /foo"], ["/foo/01"], ["/foo/bar"], ["/foo/+1"]])
def test_json_pointer_get_invalid(pointer):
  assert_eq(try: json::json_pointer_get(pointer_doc, pointer) catch: "error", "error")
end

def test_json_pointer_to_path():
  assert_eq(json::json_pointer_to_path(pointer_doc, "/foo/1"), ["foo", 1])
  | assert_eq(json::json_pointer_to_path(pointer_doc, ""), [])
  | assert_eq(json::json_pointer_to_path(pointer_doc, "/a~1b"), ["a/b"])
  | assert_eq(json::json_pointer_to_path(pointer_doc, "/foo/-"), ["foo", 2])
  | assert_eq(json::json_pointer_to_path({}, "/a/0"), ["a", "0"])
end

# @parametrize([[[], ""], [["foo", 0], "/foo/0"], [["a/b"], "/a~1b"], [["m~n"], "/m~0n"], [["~1"], "/~01"], [[""], "/"]])
def test_json_pointer_from_path(path, expected):
  assert_eq(json::json_pointer_from_path(path), expected)
end

def test_json_pointer_from_path_round_trips_paths():
  let doc = {"a/b": [1, {"~": 2}], "": 3, "0": 4}
  | let pointers = map(paths(doc), json::json_pointer_from_path)
  | assert_eq(map(pointers, fn(p): json::json_pointer_get(doc, p);), [1, 2, 3, 4])
end

def test_json_pointer_has():
  let doc = {"a": None, "b": [1]}
  | assert(json::json_pointer_has(doc, ""))
  | assert(json::json_pointer_has(doc, "/a"))
  | assert(json::json_pointer_has(doc, "/b/0"))
  | assert(!json::json_pointer_has(doc, "/b/1"))
  | assert(!json::json_pointer_has(doc, "/c"))
  | assert(!json::json_pointer_has(doc, "/c/d"))
end

# @parametrize([["/a", 9, {"a": 9, "b": [1, 2]}], ["/b/1", 9, {"a": 1, "b": [1, 9]}], ["/b/-", 9, {"a": 1, "b": [1, 2, 9]}], ["/c/d", 9, {"a": 1, "b": [1, 2], "c": {"d": 9}}], ["", 9, 9]])
def test_json_pointer_set(pointer, value, expected):
  assert_eq(json::json_pointer_set({"a": 1, "b": [1, 2]}, pointer, value), expected)
end

# @parametrize([["/a", {"b": [1, 2]}], ["/b/0", {"a": 1, "b": [2]}], ["/c", {"a": 1, "b": [1, 2]}], ["/c/d", {"a": 1, "b": [1, 2]}], ["", None]])
def test_json_pointer_del(pointer, expected):
  assert_eq(json::json_pointer_del({"a": 1, "b": [1, 2]}, pointer), expected)
end

# -- JSON Patch / Diff Tests --

# RFC 6902 Appendix A
# @parametrize([[{"foo": "bar"}, {"op": "add", "path": "/baz", "value": "qux"}, {"foo": "bar", "baz": "qux"}], [{"foo": ["bar", "baz"]}, {"op": "add", "path": "/foo/1", "value": "qux"}, {"foo": ["bar", "qux", "baz"]}], [{"foo": ["bar"]}, {"op": "add", "path": "/foo/-", "value": ["abc", "def"]}, {"foo": ["bar", ["abc", "def"]]}], [{"foo": "bar"}, {"op": "add", "path": "/foo", "value": "baz"}, {"foo": "baz"}], [{"baz": "qux", "foo": "bar"}, {"op": "remove", "path": "/baz"}, {"foo": "bar"}], [{"foo": ["bar", "qux", "baz"]}, {"op": "remove", "path": "/foo/1"}, {"foo": ["bar", "baz"]}], [{"baz": "qux", "foo": "bar"}, {"op": "replace", "path": "/baz", "value": "boo"}, {"baz": "boo", "foo": "bar"}], [{"foo": {"bar": "baz", "waldo": "fred"}, "qux": {"corge": "grault"}}, {"op": "move", "from": "/foo/waldo", "path": "/qux/thud"}, {"foo": {"bar": "baz"}, "qux": {"corge": "grault", "thud": "fred"}}], [{"foo": ["all", "grass", "cows", "eat"]}, {"op": "move", "from": "/foo/1", "path": "/foo/3"}, {"foo": ["all", "cows", "eat", "grass"]}], [{"foo": {"bar": "baz"}}, {"op": "copy", "from": "/foo/bar", "path": "/foo/copied"}, {"foo": {"bar": "baz", "copied": "baz"}}], [{"baz": "qux", "foo": ["a", 2, "c"]}, {"op": "test", "path": "/baz", "value": "qux"}, {"baz": "qux", "foo": ["a", 2, "c"]}], [{"/": 9, "~1": 10}, {"op": "test", "path": "/~01", "value": 10}, {"/": 9, "~1": 10}], [{"a": 1}, {"op": "replace", "path": "", "value": [1]}, [1]]])
def test_json_patch_single_op(doc, op, expected):
  assert_eq(json::json_patch(doc, [op]), expected)
end

# @parametrize([[{"baz": "qux"}, {"op": "test", "path": "/baz", "value": "bar"}], [{"foo": "bar"}, {"op": "add", "path": "/baz/bat", "value": "qux"}], [{"foo": [1]}, {"op": "add", "path": "/foo/5", "value": 2}], [{"foo": 1}, {"op": "remove", "path": "/bar"}], [{"foo": 1}, {"op": "replace", "path": "/bar", "value": 1}], [{"foo": 1}, {"op": "move", "from": "/bar", "path": "/baz"}], [{"foo": {"a": 1}}, {"op": "move", "from": "/foo", "path": "/foo/a"}], [{"foo": 1}, {"op": "add", "path": "/bar"}], [{"foo": 1}, {"op": "nope", "path": "/foo"}], [{"foo": 1}, {"path": "/foo"}], [{"foo": 1}, {"op": "test", "path": "/foo", "value": "1"}]])
def test_json_patch_errors(doc, op):
  assert_eq(try: json::json_patch(doc, [op]) catch: "error", "error")
end

def test_json_patch_applies_operations_in_order():
  let ops = [{"op": "add", "path": "/a", "value": 1}, {"op": "replace", "path": "/a", "value": 2}, {"op": "copy", "from": "/a", "path": "/b"}, {"op": "remove", "path": "/a"}]
  | assert_eq(json::json_patch({}, ops), {"b": 2})
end

def test_json_patch_empty_patch_is_identity():
  assert_eq(json::json_patch({"a": [1]}, []), {"a": [1]})
end

def test_json_patch_requires_an_array():
  assert_eq(try: json::json_patch({}, {"op": "add"}) catch: "error", "error")
end

def test_json_patch_does_not_change_the_input():
  let doc = {"a": [1, 2]}
  | let _ = json::json_patch(doc, [{"op": "remove", "path": "/a/0"}])
  | assert_eq(doc, {"a": [1, 2]})
end

# @parametrize([[{"a": 1}, {"a": 1}, []], [{"a": 1, "b": 2}, {"a": 1, "b": 3}, [{"op": "replace", "path": "/b", "value": 3}]], [{"a": 1}, {"a": 1, "b": 2}, [{"op": "add", "path": "/b", "value": 2}]], [{"a": 1, "b": 2}, {"a": 1}, [{"op": "remove", "path": "/b"}]], [{"a": {"b": {"c": 1}}}, {"a": {"b": {"c": 2}}}, [{"op": "replace", "path": "/a/b/c", "value": 2}]], [[1, 2, 3], [1, 2, 3, 4, 5], [{"op": "add", "path": "/3", "value": 4}, {"op": "add", "path": "/4", "value": 5}]], [[1, 2, 3, 4], [1, 2], [{"op": "remove", "path": "/3"}, {"op": "remove", "path": "/2"}]], [{"a": [1, 2]}, {"a": [1, 9]}, [{"op": "replace", "path": "/a/1", "value": 9}]], [{"a": 1}, {"a": "1"}, [{"op": "replace", "path": "/a", "value": "1"}]], [{"a": {"x": 1}}, {"a": [1]}, [{"op": "replace", "path": "/a", "value": [1]}]], [1, 2, [{"op": "replace", "path": "", "value": 2}]], [{"a/b": 1}, {"a/b": 2}, [{"op": "replace", "path": "/a~1b", "value": 2}]], [{"a": None}, {"a": 1}, [{"op": "replace", "path": "/a", "value": 1}]], [{}, {"a": None}, [{"op": "add", "path": "/a", "value": None}]]])
def test_json_diff(a, b, expected):
  assert_eq(json::json_diff(a, b), expected)
end

def test_json_diff_detects_key_rename_as_move():
  let ops = json::json_diff({"name": "x", "keep": 1}, {"title": "x", "keep": 1})
  | assert_eq(ops, [{"op": "move", "from": "/name", "path": "/title"}])
end

def test_json_diff_detects_move_between_objects():
  let ops = json::json_diff({"a": {"v": [1, 2]}, "b": {}}, {"a": {}, "b": {"v": [1, 2]}})
  | assert_eq(ops, [{"op": "move", "from": "/a/v", "path": "/b/v"}])
end

def test_json_diff_moves_can_be_disabled():
  let ops = json::json_diff({"name": "x"}, {"title": "x"}, {moves: false})
  | assert_eq(ops, [{"op": "remove", "path": "/name"}, {"op": "add", "path": "/title", "value": "x"}])
end

def test_json_diff_does_not_move_null_or_array_items():
  assert_eq(json::json_diff({"a": None}, {"b": None}), [{"op": "remove", "path": "/a"}, {"op": "add", "path": "/b", "value": None}])
  | assert_eq(json::json_diff([1, 2], [2]), [{"op": "replace", "path": "/0", "value": 2}, {"op": "remove", "path": "/1"}])
end

def test_json_diff_pairs_each_removed_key_only_once():
  let ops = json::json_diff({"a": 1, "b": 1}, {"c": 1})
  | assert_eq(ops, [{"op": "remove", "path": "/b"}, {"op": "move", "from": "/a", "path": "/c"}])
end

# @property(100, [gen::array_of(gen::int(0, 3), 0, 6), gen::array_of(gen::int(0, 3), 0, 6)])
def test_json_diff_patch_round_trip_arrays(a, b):
  assert_eq(json::json_patch(a, json::json_diff(a, b)), b)
end

# @property(100, [gen::array(gen::int(0, 2), 5), gen::array(gen::int(0, 2), 5)])
def test_json_diff_patch_round_trip_objects(xs, ys):
  let a = {"p": xs[0], "q": xs[1], "r": {"s": xs[2], "t": [xs[3], xs[4]]}}
  | let b = {"q": ys[1], "r": {"s": ys[2], "t": [ys[3]]}, "u": ys[0], "v": ys[4]}
  | assert_eq(json::json_patch(a, json::json_diff(a, b)), b)
end

# -- JSON Merge Patch / merge3 Tests --

# RFC 7396 examples (https://datatracker.ietf.org/doc/html/rfc7396#section-1)
# @parametrize([[{"a": "b"}, {"a": "c"}, {"a": "c"}], [{"a": "b"}, {"b": "c"}, {"a": "b", "b": "c"}], [{"a": "b"}, {"a": None}, {}], [{"a": "b", "b": "c"}, {"a": None}, {"b": "c"}], [{"a": ["b"]}, {"a": "c"}, {"a": "c"}], [{"a": "c"}, {"a": ["b"]}, {"a": ["b"]}], [{"a": {"b": "c"}}, {"a": {"b": "d", "c": None}}, {"a": {"b": "d"}}], [{"a": [{"b": "c"}]}, {"a": [1]}, {"a": [1]}], [["a", "b"], ["c", "d"], ["c", "d"]], [{"a": "b"}, ["c"], ["c"]], [{"a": "foo"}, None, None], [{"a": "foo"}, "bar", "bar"], [{"e": None}, {"a": 1}, {"e": None, "a": 1}], [[1, 2], {"a": "b", "c": None}, {"a": "b"}], [{}, {"a": {"bb": {"ccc": None}}}, {"a": {"bb": {}}}]])
def test_json_merge_patch_rfc7396(doc, patch, expected):
  assert_eq(json::json_merge_patch(doc, patch), expected)
end

def test_json_merge_patch_nested():
  assert_eq(
    json::json_merge_patch({"a": 1, "b": {"c": 2, "d": 3}}, {"a": None, "b": {"c": 9}}),
    {"b": {"c": 9, "d": 3}}
  )
end

def test_merge3_no_conflict():
  assert_eq(json::merge3({"a": 1, "b": 1}, {"a": 2, "b": 1}, {"a": 1, "b": 3}), {"value": {"a": 2, "b": 3}, "conflicts": []})
end

def test_merge3_same_edit_both_sides_is_not_a_conflict():
  assert_eq(json::merge3({"a": 1}, {"a": 2}, {"a": 2}), {"value": {"a": 2}, "conflicts": []})
end

def test_merge3_conflicting_edit():
  assert_eq(json::merge3({"a": 1}, {"a": 2}, {"a": 3}), {"value": {"a": 2}, "conflicts": [{"path": "/a", "base": 1, "ours": 2, "theirs": 3}]})
end

def test_merge3_independent_additions_are_not_conflicts():
  assert_eq(json::merge3({}, {"a": 1}, {"b": 2}), {"value": {"a": 1, "b": 2}, "conflicts": []})
end

def test_merge3_both_sides_add_same_key_differently_is_a_conflict():
  assert_eq(json::merge3({}, {"a": 1}, {"a": 2}), {"value": {"a": 1}, "conflicts": [{"path": "/a", "base": None, "ours": 1, "theirs": 2}]})
end

def test_merge3_unchanged_side_yields_to_a_deletion():
  assert_eq(json::merge3({"a": 1}, {"a": 1}, {}), {"value": {}, "conflicts": []})
  | assert_eq(json::merge3({"a": 1}, {}, {"a": 1}), {"value": {}, "conflicts": []})
end

def test_merge3_edit_vs_delete_favors_ours_edit():
  assert_eq(json::merge3({"a": 1}, {"a": 2}, {}), {"value": {"a": 2}, "conflicts": [{"path": "/a", "base": 1, "ours": 2, "theirs": None}]})
end

def test_merge3_delete_vs_edit_favors_ours_delete():
  assert_eq(json::merge3({"a": 1}, {}, {"a": 2}), {"value": {}, "conflicts": [{"path": "/a", "base": 1, "ours": None, "theirs": 2}]})
end

def test_merge3_recurses_into_nested_dicts():
  let result = json::merge3({"a": {"x": 1, "y": 1}}, {"a": {"x": 2, "y": 1}}, {"a": {"x": 1, "y": 3}})
  | assert_eq(result, {"value": {"a": {"x": 2, "y": 3}}, "conflicts": []})
end

def test_merge3_arrays_compared_as_a_whole():
  assert_eq(json::merge3({"a": [1, 2]}, {"a": [1, 2, 3]}, {"a": [1, 2, 4]}), {"value": {"a": [1, 2, 3]}, "conflicts": [{"path": "/a", "base": [1, 2], "ours": [1, 2, 3], "theirs": [1, 2, 4]}]})
end

def test_merge3_identical_edit_on_both_sides():
  assert_eq(json::merge3(1, 2, 2), {"value": 2, "conflicts": []})
end

# @property(60, [gen::array(gen::int(0, 2), 3), gen::array(gen::int(0, 2), 3)])
def test_merge3_ours_edits_alone_apply_cleanly(xs, ys):
  let base = {"a": xs[0], "b": xs[1], "c": xs[2]}
  | let ours = {"a": ys[0], "b": ys[1], "c": ys[2]}
  | let result = json::merge3(base, ours, base)
  | assert_eq(result, {"value": ours, "conflicts": []})
end
