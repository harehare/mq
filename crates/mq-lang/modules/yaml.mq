# Based on YAML 1.2 specification

def _yaml_escape_control_char(code):
  if (code < 32):
    "\\u00" + slice("0123456789abcdef", code / 16, code / 16 + 1) + slice("0123456789abcdef", code % 16, code % 16 + 1)
  else:
    implode([code])
end

def _yaml_escape_common(str):
  replace(str, "\\", "\\\\") | replace("\"", "\\\"") | replace("\n", "\\n") | replace("\t", "\\t") | replace("\r", "\\r")
end

def _escape_string(str):
  let escaped = _yaml_escape_common(str)
  | if (test(escaped, "[\\x00-\\x1f\\x7f]")): join(map(explode(escaped), _yaml_escape_control_char), "") else: escaped
end

# True when a plain scalar would be read back as something other than the same string.
def _yaml_needs_quotes(str):
  is_empty(str)
   || test(str, "^\\s|\\s$")
   || test(str, "[\\x00-\\x1f\\x7f\"']")
   || test(str, "^[-?:,\\[\\]{}#&*!|>%@`]|^\\.\\.\\.")
   || test(str, ": | #|:$")
   || contains(["true", "false", "null", "yes", "no", "on", "off", "~"], downcase(str))
   || test(str, "^[-+]?(\\.[0-9]+|[0-9][0-9_]*(\\.[0-9_]*)?)([eE][-+]?[0-9]+)?$")
   || test(str, "^0[xo][0-9a-fA-F]+$")
   || test(downcase(str), "^[-+]?\\.inf$|^\\.nan$")
end

def _yaml_scalar(str):
  if (_yaml_needs_quotes(str)):
    "\"" + _escape_string(str) + "\""
  else:
    str
end

# True for a non-empty array or dict, which is written as an indented block.
def _yaml_is_block(value):
  if (is_array(value)):
    !is_empty(value)
  elif (is_dict(value)):
    !is_empty(keys(value))
  else:
    false
end

# Joins an entry head (`key:` or `-`) and its rendered value without a trailing space before a block.
def _yaml_entry(head, value, rendered):
  if (_yaml_is_block(value)): head + rendered else: head + " " + rendered
end

# Renders a value as a Markdown table cell, escaping `|` and newlines.
def _yaml_table_cell(value):
  if (is_none(value)): "" else: replace(replace(to_string(value), "\n", "\\n"), "|", "\\|")
end

def _yaml_stringify_value(value, indent_level):
  let indent = repeat(" ", indent_level * 2)
  | if (is_string(value)):
      _yaml_scalar(value)
    elif (is_number(value)):
      to_string(value)
    elif (is_bool(value)):
      if (value): "true" else: "false"
    elif (is_none(value)):
      "null"
    elif (is_array(value)):
      if (is_empty(value)):
        "[]"
      else:
        join(map(value, fn(item): "\n" + indent + _yaml_entry("-", item, _yaml_stringify_value(item, indent_level + 1));), "")
    elif (is_dict(value)):
      if (is_empty(keys(value))):
        "{}"
      else:
        join(map(keys(value), fn(k): "\n" + indent + _yaml_entry(_yaml_scalar(k) + ":", value[k], _yaml_stringify_value(value[k], indent_level + 1));), "")
    else:
      to_string(value)
end

# Parses a YAML string and returns the parsed data structure.
# A single `---`-separated document is returned as-is; if the input contains
# multiple `---`-separated documents, an array of the parsed documents is returned.
#
# Example:
# ```
# import "yaml" | yaml::yaml_parse("key: 1")
# #=> {"key": 1}
# ```
#
# Returns: dynamic
def yaml_parse(input):
  _yaml_parse(to_string(input))
end

# Parses a YAML string without raising on invalid input.
#
# Example:
# ```
# import "yaml" | yaml::yaml_try_parse("key: 1")["ok"]
# #=> true
# ```
# Example:
# ```
# import "yaml" | yaml::yaml_try_parse("key: [unterminated")["ok"]
# #=> false
# ```
#
# Returns: dict
def yaml_try_parse(input):
  try: {ok: true, value: yaml_parse(input), error: None}
  catch(e): {ok: false, value: None, error: {message: e["message"]}}
end

# Converts a data structure to a YAML string representation.
#
# Example:
# ```
# import "yaml" | yaml::yaml_stringify({"key": 1})
# #=> key: 1
# ```
#
# Returns: string
def yaml_stringify(data):
  if (is_array(data)):
    if (is_empty(data)):
      "[]"
    else:
      join(map(data, fn(item): _yaml_entry("-", item, _yaml_stringify_value(item, 1));), "\n")
  elif (is_dict(data)):
    if (is_empty(keys(data))):
      "{}"
    else:
      join(map(keys(data), fn(k): _yaml_entry(_yaml_scalar(k) + ":", data[k], _yaml_stringify_value(data[k], 1));), "\n")
  else:
    _yaml_stringify_value(data, 0)
end

# Converts a YAML data structure to a Markdown table.
# The columns are the union of the keys of all rows, in first-seen order.
# `|` and newlines in cells are escaped, and an empty array gives an empty string.
#
# Example:
# ```
# import "yaml" | yaml::yaml_to_markdown_table([{"a": 1}])
# #=> | a |
# | --- |
# | 1 |
# ```
#
# Returns: string
def yaml_to_markdown_table(data):
  if (is_array(data) && is_empty(data)):
    ""
  elif (is_array(data)):
    do
      let headers = uniq(flatten(map(data, fn(row): keys(row);)))
      | let header_row = "| " + join(map(headers, _yaml_table_cell), " | ") + " |"
      | let separator_row = "| " + join(map(headers, fn(_): "---";), " | ") + " |"
      | let data_rows = map(data, fn(row):
          "| " + join(map(headers, fn(header): _yaml_table_cell(row[header]);), " | ") + " |"
        end)
      | [header_row, separator_row] + data_rows
      | join("\n")
    end
  elif (is_dict(data)):
    do
      let headers = ["Key", "Value"]
      | let header_row = "| " + join(headers, " | ") + " |"
      | let separator_row = "| " + join(map(headers, fn(_): "---";), " | ") + " |"
      | let data_rows = map(keys(data), fn(key):
          "| " + _yaml_table_cell(key) + " | " + _yaml_table_cell(data[key]) + " |"
        end)
      | [header_row, separator_row] + data_rows
      | join("\n")
    end
  else:
    "| Value |\n| --- |\n| " + _yaml_table_cell(data) + " |"
end

# Converts a data structure to a JSON string representation.
#
# Example:
# ```
# import "yaml" | yaml::yaml_to_json({"key": 1})
# #=> {"key": 1}
# ```
#
# Returns: string
def yaml_to_json(data):
  if (is_dict(data)):
    "{" + join(map(keys(data), fn(k): "\"" + _escape_string(k) + "\": " + yaml_to_json(data[k]);), ", ") + "}"
  elif (is_array(data)):
    "[" + join(map(data, yaml_to_json), ", ") + "]"
  elif (is_string(data)):
    "\"" + _escape_string(data) + "\""
  elif (is_number(data)):
    to_string(data)
  elif (is_bool(data)):
    if (data): "true" else: "false"
  elif (is_none(data)):
    "null"
  else:
    "\"" + to_string(data) + "\""
end

# Converts a data structure to a YAML front matter string.
#
# Example:
# ```
# import "yaml" | yaml::to_frontmatter({"key": 1})
# #=> ---
# key: 1
# ---
# ```
#
# Returns: string
def to_frontmatter(data):
  "---\n" + yaml_stringify(data) + "\n---"
end
