# CSV/TSV Implementation in mq.
# Based on RFC 4180 for CSV format.

# Checks whether a field's string form needs quoting for the given delimiter (RFC 4180):
# it contains a quote, newline, carriage return, the delimiter itself, or leading/trailing
# whitespace.
#
# Example:
# ```
# import "csv" | csv::csv_needs_quote("a,b", ",")
# #=> true
# ```
#
# Returns: bool
def csv_needs_quote(field, delimiter):
  let s = to_string(field)
  | contains(s, "\"") || contains(s, "\n") || contains(s, "\r") || contains(s, delimiter) || starts_with(s, " ") || ends_with(s, " ")
end

# Quotes a field when needed. None becomes an empty field; 0 and false are kept.
def _csv_field(field, delimiter):
  if (is_none(field)):
    ""
  else:
    let s = to_string(field)
    | if (csv_needs_quote(field, delimiter)): "\"" + replace(s, "\"", "\"\"") + "\"" else: s
end

# Dict rows use the union of all keys, in first-seen order. Array rows use the first row.
def _csv_headers(data):
  if (is_empty(data)):
    []
  elif (is_dict(first(data))):
    uniq(flat_map(data, fn(row): keys(row);))
  else:
    first(data)
end

# Escapes `|` and newlines so a value stays inside its Markdown table cell.
def _csv_md_cell(value):
  if (is_none(value)): "" else: replace(replace(to_string(value), "|", "\\|"), "\n", "\\n")
end

# Parses CSV content with a specified delimiter and optional header row.
#
# Example:
# ```
# import "csv" | csv::csv_parse_with_delimiter("a;b\n1;2", ";", true)
# #=> [{"a": "1", "b": "2"}]
# ```
#
# Returns: array
def csv_parse_with_delimiter(input, delimiter, has_header): _csv_parse(input, delimiter, has_header);

# Parses CSV content using a comma as the delimiter.
#
# Example:
# ```
# import "csv" | csv::csv_parse("name,age\nAlice,30", true)
# #=> [{"name": "Alice", "age": "30"}]
# ```
#
# Returns: array
def csv_parse(input, has_header): _csv_parse(input, ",", has_header);

# Parses TSV (Tab-Separated Values) content.
#
# Example:
# ```
# import "csv" | csv::tsv_parse("name\tage\nAlice\t30", true)
# #=> [{"name": "Alice", "age": "30"}]
# ```
#
# Returns: array
def tsv_parse(input, has_header): _csv_parse(input, "\t", has_header);

# Parses PSV (Pipe-Separated Values) content.
#
# Example:
# ```
# import "csv" | csv::psv_parse("name|age\nAlice|30", true)
# #=> [{"name": "Alice", "age": "30"}]
# ```
#
# Returns: array
def psv_parse(input, has_header): _csv_parse(input, "|", has_header);

# Converts data to a CSV string with a specified delimiter.
#
# Example:
# ```
# import "csv" | csv::csv_stringify([{"name": "Alice", "age": 30}], ",")
# #=> name,age
# Alice,30
# ```
#
# Returns: string
def csv_stringify(data, delimiter):
  let headers = _csv_headers(data)
  | let rows = if (!is_empty(data) && is_dict(first(data))): data else: skip(data, 1)
  | let to_line = fn(row): join(map(if (is_dict(row)): map(headers, fn(h): row[h];) else: row, fn(f): _csv_field(f, delimiter);), delimiter);
  | if (is_empty(data)):
      ""
    else:
      join([to_line(headers)] + map(rows, to_line), "\n")
end

# Converts CSV data to a Markdown table format.
#
# Example:
# ```
# import "csv" | csv::csv_to_markdown_table([{"name": "Alice", "age": 30}])
# #=> | name | age |
# | --- | --- |
# | Alice | 30 |
# ```
#
# Returns: string
def csv_to_markdown_table(data):
  if (is_empty(data)):
    ""
  else:
    do
      let headers = _csv_headers(data)
      | let rows = if (is_dict(first(data))): data else: skip(data, 1)
      | let to_row = fn(cells): "| " + join(map(cells, _csv_md_cell), " | ") + " |";
      | let data_rows = map(rows, fn(row): to_row(if (is_dict(row)): map(headers, fn(h): row[h];) else: row);)
      | join([to_row(headers), "| " + join(map(headers, fn(_): "---";), " | ") + " |"] + data_rows, "\n")
    end
end

# Converts CSV data to a JSON string.
#
# Example:
# ```
# import "csv" | csv::csv_to_json([{"name": "Alice", "age": 30}])
# #=> [{"name":"Alice","age":30}]
# ```
# Example:
# ```
# import "csv" | csv::csv_to_json([{"name": "back\\slash"}])
# #=> [{"name":"back\\slash"}]
# ```
#
# Returns: string
def csv_to_json(data):
  def _escape_control_char(code):
    if (code < 32):
      "\\u00" + slice("0123456789abcdef", code / 16, code / 16 + 1) + slice("0123456789abcdef", code % 16, code % 16 + 1)
    else:
      implode([code])
  end

  def _escape_json_string(str):
    let escaped = replace(replace(replace(replace(replace(str, "\\", "\\\\"), "\"", "\\\""), "\n", "\\n"), "\t", "\\t"), "\r", "\\r")
    | if (test(escaped, "[\\x00-\\x1f]")): join(map(explode(escaped), _escape_control_char), "") else: escaped
  end

  def _to_json(value):
    if (is_dict(value)):
      "{" + join(map(keys(value), fn(k): "\"" + _escape_json_string(k) + "\":" + _to_json(value[k]);), ",") + "}"
    elif (is_array(value)):
      "[" + join(map(value, _to_json), ",") + "]"
    elif (is_string(value)):
      "\"" + _escape_json_string(value) + "\""
    elif (is_number(value)):
      to_string(value)
    elif (is_bool(value)):
      if (value): "true" else: "false"
    elif (is_none(value)):
      "null"
    else:
      "\"" + _escape_json_string(to_string(value)) + "\""
  end

  | if (is_array(data) && len(data) > 0 && is_dict(first(data))):
      _to_json(data)
    else:
      _to_json(map(data, fn(row): row;))
end

def _fill_is_missing(v, missing):
  if (missing == "empty"): v == ""
  elif (missing == "none"): is_none(v)
  elif (missing == "both"): is_none(v) || v == ""
  else: error("csv: missing must be \"empty\", \"none\" or \"both\", got " + to_string(missing))
end

# Splits rows into [header, data]. Array rows treat the first row as the header.
def _fill_split(rows):
  if (is_array(first(rows))): [first(rows), rows[1:len(rows)]] else: [None, rows]
end

# Resolves a column name to an array index. Dict rows and numeric columns pass through.
def _fill_col(header, c):
  if (is_none(header) || !is_string(c)):
    c
  else:
    do
      let i = index(header, c)
      | if (i < 0): error("csv: column not found: " + c) else: i
    end
end

def _fill_step(s, c, gkey, missing, max_gap):
  let k = gkey + "|" + to_string(c)
  | let v = s["row"][c]
  | if (_fill_is_missing(v, missing)):
      do
        let n = (s["gap"][k] ?? 0) + 1
        | let prev = s["last"][k]
        | let fillable = !is_none(prev) && (is_none(max_gap) || n <= max_gap)
        | {"row": if (fillable): set(s["row"], c, first(prev)) else: s["row"], "last": s["last"], "gap": set(s["gap"], k, n)}
      end
    else:
      {"row": s["row"], "last": set(s["last"], k, [v]), "gap": set(s["gap"], k, 0)}
end

# Fills data rows (no header) top to bottom. `header` is None for dict rows.
def _fill_forward(header, data, cols, group_by, missing, max_gap):
  let col_ids = map(cols, fn(c): _fill_col(header, c);)
  | let group_ids = map(group_by, fn(g): _fill_col(header, g);)
  | let init = {"rows": [], "last": {}, "gap": {}}
  | let filled = fold(data, init, fn(acc, row):
      let gkey = to_string(map(group_ids, fn(g): row[g];))
      | let step = fold(col_ids, {"row": row, "last": acc["last"], "gap": acc["gap"]}, fn(s, c): _fill_step(s, c, gkey, missing, max_gap);)
      | {"rows": acc["rows"] + [step["row"]], "last": step["last"], "gap": step["gap"]};)
  | filled["rows"]
end

def _fill_with_header(header, data):
  if (is_none(header)): data else: [header] + data
end

# Fills missing cells in the given columns with the last non-missing value above.
# Rows are dicts or arrays (the first array row is the header and is left as is).
# `cols` are column names, or indexes for array rows. `group_by` columns keep a separate
# carried value per group. `missing` is "empty", "none" or "both". `max_gap` limits how many
# consecutive missing cells are filled. Cells with no value above stay missing.
#
# Example:
# ```
# import "csv" | csv::forward_fill([{"a": "x"}, {"a": ""}], ["a"])
# #=> [{"a": "x"}, {"a": "x"}]
# ```
#
# Returns: array
def forward_fill(rows, cols, group_by = [], missing = "both", max_gap = None):
  if (len(rows) == 0):
    rows
  else:
    do
      let parts = _fill_split(rows)
      | _fill_with_header(parts[0], _fill_forward(parts[0], parts[1], cols, group_by, missing, max_gap))
    end
end

# Fills missing cells in the given columns with the next non-missing value below.
# Takes the same arguments as `forward_fill`. With `max_gap`, the cells nearest to the value are filled.
#
# Example:
# ```
# import "csv" | csv::backward_fill([{"a": ""}, {"a": "x"}], ["a"])
# #=> [{"a": "x"}, {"a": "x"}]
# ```
#
# Returns: array
def backward_fill(rows, cols, group_by = [], missing = "both", max_gap = None):
  if (len(rows) == 0):
    rows
  else:
    do
      let parts = _fill_split(rows)
      | _fill_with_header(parts[0], reverse(_fill_forward(parts[0], reverse(parts[1]), cols, group_by, missing, max_gap)))
    end
end

# Fills missing cells with a constant per column. `defaults` maps column names to values.
# Array rows use header names as keys. Values are inserted as given, without type conversion.
#
# Example:
# ```
# import "csv" | csv::constant_fill([{"a": ""}, {"a": "x"}], {"a": "N/A"})
# #=> [{"a": "N/A"}, {"a": "x"}]
# ```
#
# Returns: array
def constant_fill(rows, defaults, missing = "both"):
  if (len(rows) == 0):
    rows
  else:
    do
      let parts = _fill_split(rows)
      | let header = parts[0]
      | let cols = keys(defaults)
      | let filled = map(parts[1], fn(row):
          fold(cols, row, fn(r, c):
            let idx = _fill_col(header, c)
            | if (_fill_is_missing(r[idx], missing)): set(r, idx, defaults[c]) else: r;);)
      | _fill_with_header(header, filled)
    end
end
