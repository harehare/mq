import "cbor"
| include "test"

# Wrong argument types raise an error.
# @parametrize([
#   [fn(): cbor::cbor_parse(1);],
# ])
def test_cbor_argument_type_errors(op):
  let result = try: op() catch: "error"
  | assert_eq(result, "error")
end

# Valid arguments are accepted by the same calls.
# @parametrize([
#   [fn(): cbor::cbor_parse(cbor::cbor_stringify({"a": 1}));],
# ])
def test_cbor_valid_arguments_accepted(op):
  let result = try: op() catch: "error"
  | assert_ne(result, "error")
end
