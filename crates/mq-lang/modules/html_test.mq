import "html"
| import "json"
| include "test"

# -- HTML Tests --

| let html_input = "<!DOCTYPE html><html><body><div class=\"a\"><p>hi <b>there</b></p><img src=\"x.png\"></div></body></html>" |

def test_html_parse_root_tag():
  let result = html::html_parse(html_input)
  | assert_eq(result["tag"], "html")
end

def test_html_parse_nested_element():
  let result = html::html_parse(html_input)
  | let div = first(result["children"][1]["children"])
  | assert_eq(div["tag"], "div")
  | assert_eq(div["attributes"]["class"], "a")
end

def test_html_parse_collapses_text_around_inline_elements():
  let result = html::html_parse(html_input)
  | let div = first(result["children"][1]["children"])
  | let p = first(div["children"])
  | assert_eq(p["text"], "hi")
end

def test_html_parse_void_element_has_no_children_or_text():
  let result = html::html_parse(html_input)
  | let div = first(result["children"][1]["children"])
  | let img = last(div["children"])
  | assert_eq(img["tag"], "img")
  | assert_eq(img["attributes"]["src"], "x.png")
  | assert_true(is_empty(img["children"]))
  | assert_true(is_none(img["text"]))
end

def test_html_stringify_void_element():
  assert_eq(
    html::html_stringify({"tag": "br", "attributes": {}, "children": [], "text": None}),
    "<br>")
end

def test_html_stringify_roundtrip():
  let parsed = html::html_parse("<p class=\"a\">hi &amp; bye</p>")
  | let body = last(parsed["children"])
  | let p = first(body["children"])
  | assert_eq(html::html_stringify(p), "<p class=\"a\">hi &amp; bye</p>")
end

def test_html_stringify_escapes_text_and_attributes():
  assert_eq(
    html::html_stringify({"tag": "p", "attributes": {"title": "a \"quote\""}, "children": [], "text": "<b> & </b>"}),
    "<p title=\"a &quot;quote&quot;\">&lt;b&gt; &amp; &lt;/b&gt;</p>")
end

# Unlike xml_test.mq's equivalent property, `_escape_text`/`_escape_attr` here do escape
# `&`/`<`/`>`/`"`, so those characters are deliberately included in the charset. No spaces, to
# avoid depending on whether the underlying HTML parser normalizes surrounding whitespace in
# text nodes.
# @property(50, [gen::string("abcXYZ01&<>\"'", 6), gen::string("abcXYZ01&<>\"'", 6)])
def test_html_stringify_parse_round_trip(text, attr_value):
  let el = {"tag": "p", "attributes": {"title": attr_value}, "children": [], "text": text}
  | let doc = html::html_parse(html::html_stringify(el))
  | let body = last(doc["children"])
  | let p = first(body["children"])
  | assert_eq(p["text"], text)
  | assert_eq(p["attributes"]["title"], attr_value)
end

# @parametrize([["p", 1], ["img", 1], ["div", 1], ["nope", 0]])
def test_html_find_all(tag, expected_len):
  let result = html::html_find_all(html::html_parse(html_input), tag)
  | assert_eq(len(result), expected_len)
end

# @parametrize([["img", "img"], ["div", "div"], ["nope", None]])
def test_html_find(tag, expected_tag):
  let result = html::html_find(html::html_parse(html_input), tag)
  | let actual_tag = if (is_none(result)): None else: result["tag"]
  | assert_eq(actual_tag, expected_tag)
end

# @parametrize([["src", "x.png"], ["alt", None]])
def test_html_attr(name, expected):
  let img = html::html_find(html::html_parse(html_input), "img")
  | assert_eq(html::html_attr(img, name), expected)
end

# @parametrize([
#   ["<p>hi <b>there</b></p>", "hi there"],
#   ["<p><span></span></p>", ""],
#   ["<div><p>a</p><p>b</p></div>", "a b"],
# ])
def test_html_text(input, expected):
  assert_eq(html::html_text(html::html_parse(input)), expected)
end

def test_html_to_json_roundtrips():
  let parsed = html::html_parse(html_input)
  | let result = html::html_to_json(parsed)
  | assert_eq(json::json_parse(result), parsed)
end

# @parametrize([
#   [{"tag": "a"}, "{\"tag\": \"a\"}"],
#   [{"tag": "br", "attributes": {}, "children": [], "text": None}, "{\"tag\": \"br\", \"attributes\": {}, \"children\": [], \"text\": null}"],
# ])
def test_html_to_json_simple(data, expected):
  assert_eq(html::html_to_json(data), expected)
end

| let select_input = "<html><body><div id=\"main\" class=\"box big\" data-id=\"1\"><p class=\"price\" data-id=\"1\">$10</p><p class=\"price\" data-id=\"2\">$20</p><a href=\"https://example.com/x.pdf\" lang=\"en-US\">link</a><span class=\"empty\"></span><section><p class=\"deep\">d</p></section></div><div class=\"other\"><p>o</p></div></body></html>" |

def _select_texts(selector):
  map(html::html_select(html::html_parse(select_input), selector), html::html_text)
end

# @parametrize([
#   ["p", ["$10", "$20", "d", "o"]],
#   ["a", ["link"]],
#   ["DIV > a", ["link"]],
#   [".price", ["$10", "$20"]],
#   ["p.price", ["$10", "$20"]],
#   [".box.big .deep", ["d"]],
#   ["#main > a", ["link"]],
#   ["div#main", ["$10 $20 link d"]],
#   ["*.deep", ["d"]],
# ])
def test_html_select_type_class_id(selector, expected):
  assert_eq(_select_texts(selector), expected)
end

# @parametrize([
#   ["[data-id]", ["$10 $20 link d", "$10", "$20"]],
#   ["[data-id=\"2\"]", ["$20"]],
#   ["[data-id=2]", ["$20"]],
#   ["p[data-id='1']", ["$10"]],
#   ["[ data-id = 2 ]", ["$20"]],
#   ["[class~=big]", ["$10 $20 link d"]],
#   ["[class~=ig]", []],
#   ["a[href^=\"https://\"]", ["link"]],
#   ["a[href$=\".pdf\"]", ["link"]],
#   ["a[href*=example]", ["link"]],
#   ["a[href$=\".png\"]", []],
#   ["[lang^=\"\"]", []],
# ])
def test_html_select_attribute_operators(selector, expected):
  assert_eq(_select_texts(selector), expected)
end

# @parametrize([
#   ["div p", ["$10", "$20", "d", "o"]],
#   ["div > p", ["$10", "$20", "o"]],
#   ["#main p", ["$10", "$20", "d"]],
#   ["#main > p", ["$10", "$20"]],
#   [".price + a", ["link"]],
#   [".price + .price", ["$20"]],
#   ["p + span", []],
#   [".price ~ span", [""]],
#   [".price ~ section", ["d"]],
#   ["a ~ .price", []],
#   ["body > div > section > p", ["d"]],
#   ["div>p.price+p", ["$20"]],
# ])
def test_html_select_combinators(selector, expected):
  assert_eq(_select_texts(selector), expected)
end

def test_html_select_comma_list_is_document_order_without_duplicates():
  assert_eq(_select_texts("a, .price, p.price, .deep"), ["$10", "$20", "link", "d"])
end

# @parametrize([
#   ["p:first-child", ["$10", "d", "o"]],
#   ["p:last-child", ["d", "o"]],
#   ["p:nth-child(2)", ["$20"]],
#   ["div > :nth-child(odd)", ["$10", "link", "d", "o"]],
#   ["#main > :nth-child(even)", ["$20", ""]],
#   ["#main > :nth-child(2n+1)", ["$10", "link", "d"]],
#   ["#main > :nth-child(n+4)", ["", "d"]],
#   ["#main > :nth-child(-n+2)", ["$10", "$20"]],
#   ["p:not(.price)", ["d", "o"]],
#   ["#main > :not(p, a)", ["", "d"]],
#   ["div:not(#main):not(.nothing) > p", ["o"]],
# ])
def test_html_select_pseudo_classes(selector, expected):
  assert_eq(_select_texts(selector), expected)
end

# @parametrize([
#   ["a:not([title=\")\"])", ["y", "z"]],
#   ["a:not([title=\"(\"])", ["x", "z"]],
#   ["a:not([title=')'])", ["y", "z"]],
#   ["a:not([title=\"(\"], [title=\")\"])", ["z"]],
# ])
def test_html_select_not_quoted_parens(selector, expected):
  let html_text = "<a title=\")\">x</a><a title=\"(\">y</a><a>z</a>"
  | assert_eq(map(html::html_select(html_text, selector), fn(e): e["text"];), expected)
end

# @parametrize([
#   ["li:nth-child(2n+1)"],
#   ["li:nth-child(2n + 1)"],
#   ["li:nth-child(2n\t+\t1)"],
#   ["li:nth-child(2n\n+\n1)"],
# ])
def test_html_select_nth_child_whitespace(selector):
  let html_text = "<ul><li>A</li><li>B</li><li>C</li></ul>"
  | assert_eq(map(html::html_select(html_text, selector), fn(e): e["text"];), ["A", "C"])
end

def test_html_select_no_match_is_empty_array():
  assert_eq(html::html_select(html::html_parse(select_input), ".missing"), [])
end

def test_html_select_empty_element_has_empty_text():
  assert_eq(_select_texts(".empty"), [""])
end

def test_html_select_matches_root_and_accepts_html_string():
  assert_eq(map(html::html_select(select_input, "html"), fn(e): e["tag"];), ["html"])
end

def test_html_select_attr_values():
  let matches = html::html_select(html::html_parse(select_input), ".price")
  | assert_eq(map(matches, fn(e): html::html_attr(e, "data-id");), ["1", "2"])
  | assert_eq(map(matches, fn(e): html::html_attr(e, "href");), [None, None])
end

# @parametrize([
#   ["[[["],
#   [""],
#   ["div >"],
#   ["> div"],
#   ["div,"],
#   ["p:hover"],
#   ["p:nth-child"],
#   ["p:nth-child(x)"],
#   ["p:first-child(1)"],
#   ["p[a=]"],
#   ["a!b"],
# ])
def test_html_select_invalid_selector_is_error(selector):
  assert_eq(try: html::html_select(html::html_parse(select_input), selector) catch: "error", "error")
end
