import "toml"
| import "json"
| import "gen"
| include "test"

# -- TOML Tests --

| let toml_input = "[package]\nauthors = [\"Test Author <test@example.com>\"]\ndescription = \"A test TOML configuration file\"\nedition = \"2021\"\nlicense = \"MIT\"\nname = \"test-package\"\nversion = \"1.0.0\"\n\n[dependencies]\n" |

def test_toml_parse():
  let result = toml::toml_parse(toml_input)
  | assert_eq(len(result), 2)
end

def test_toml_try_parse_ok():
  let result = toml::toml_try_parse("key = 1")
  | assert_eq(result["ok"], true)
  | assert_eq(result["value"], {"key": 1})
  | assert_eq(result["error"], None)
end

def test_toml_try_parse_error():
  let result = toml::toml_try_parse("key = ")
  | assert_eq(result["ok"], false)
  | assert_eq(result["value"], None)
  | assert_eq(is_string(result["error"]["message"]), true)
end

def test_toml_to_json():
  let parsed = toml::toml_parse(toml_input)
  | let result = toml::toml_to_json(parsed)
  | assert_eq(json::json_parse(result), parsed)
end

# Regression test: an array value must round-trip through toml_stringify.
# A scalar array used to be rendered as an invalid `[[key]]` array-of-tables
# block containing bare trailing-comma lines instead of `key = [...]`; an
# array of dicts used to dump each entry as an inline table (`{...}`) on its
# own trailing-comma line instead of proper `[[key]]` sections.
# @parametrize([
# [{"tags": ["a", "b"]}],
# [{"tags": []}],
# [{"nums": [1, 2, 3]}],
# [{"users": [{"name": "a"}, {"name": "b"}]}],
# ])
def test_toml_stringify_array_round_trips(input):
  let result = toml::toml_stringify(input)
  | assert_eq(toml::toml_parse(result), input)
end

# `s` deliberately draws from a charset including quotes/backslashes/newlines/tabs to exercise
# `_toml_stringify_value`'s string escaping. Keys stay top-level scalars/arrays (no nested dict)
# so a `[section]` header is never emitted, matching the flat-value case `_add_toml_lines`
# handles above.
# @property(50, [gen::string("abc XYZ012\"\\\n\t", 8), gen::int(-1000000, 1000000), gen::bool(), gen::array(gen::int(-100, 100), 4)])
def test_toml_stringify_parse_round_trip(s, n, b, arr):
  let data = {"s": s, "n": n, "b": b, "arr": arr}
  | assert_eq(toml::toml_parse(toml::toml_stringify(data)), data)
end

# Keys that are not bare (spaces, dots, quotes, empty) must be quoted, including in table headers.
# @parametrize([
# [{"a b": 1}], [{"a.b": 1}], [{"": 1}], [{"a\"b\\c": 1}],
# [{"t": {"a b": 1}}], [{"a b": {"c d": {"e f": [1]}}}], [{"a b": [{"c d": 1}]}],
# ])
def test_toml_stringify_quotes_keys(input):
  assert_eq(toml::toml_parse(toml::toml_stringify(input)), input)
end

# @parametrize([["x\ry"], ["x\u0001y"], ["x\u007fy"], ["\u0000"], ["a\nb\tc\"\\"]])
def test_toml_stringify_escapes_control_characters(s):
  let data = {"k": s}
  | assert_eq(toml::toml_parse(toml::toml_stringify(data)), data)
end

# A key written after a `[table]` header would be parsed as a member of that table, so scalars
# and arrays must be emitted before any table.
# @parametrize([
# [{"t": {"x": 2}, "z": 3}],
# [{"t": {}, "z": 3}],
# [{"arr": [{"a": 1}, {"a": 2}], "z": 1}],
# [{"a": 1, "t": {"x": 2}, "z": [1, 2], "u": {"y": 3}}],
# ])
def test_toml_stringify_keeps_scalars_out_of_tables(input):
  assert_eq(toml::toml_parse(toml::toml_stringify(input)), input)
end

# TOML has no null: None-valued keys are omitted, and a null inside an array is an error.
# @parametrize([
# [{"a": 1, "k": None}, {"a": 1}],
# [{"t": {"x": None, "y": 1}, "u": 1}, {"t": {"y": 1}, "u": 1}],
# [{"t": {"x": None}}, {"t": {}}],
# [{"arr": [{"a": 1, "b": None}]}, {"arr": [{"a": 1}]}],
# ])
def test_toml_stringify_omits_none(input, expected):
  assert_eq(toml::toml_parse(toml::toml_stringify(input)), expected)
end

def test_toml_stringify_none_in_array_is_error():
  assert_eq(try: toml::toml_stringify({"k": [1, None]}) catch(e): "error", "error")
end

# @parametrize([[{"title": "title", "draft": false}], [{"count": 3}]])
def test_toml_to_frontmatter(input):
  let result = toml::to_frontmatter(input)
  | assert(starts_with(result, "+++\n"))
  | assert(ends_with(result, "\n+++"))
  | let body = result[4:len(result) - 4]
  | assert_eq(toml::toml_parse(body), input)
end
