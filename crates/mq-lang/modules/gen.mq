# Generator combinators for property-based testing.
#
# A generator is a plain function `fn(seed): value;` — a pure, deterministic mapping from an
# integer seed to a generated value, built on top of the seeded `rand`/`rand_int`/`random_string`
# builtins. Combinators below build bigger generators out of smaller ones, deriving a distinct
# sub-seed for each part so nested generators never accidentally correlate with one another.
#
# Pairs with `mq-test`'s `# @property(count, generators)` annotation: `generators` is an array
# with one generator per test parameter, and each of the `count` iterations calls
# `gen::tuple(generators)` with the iteration index as the seed. A failing iteration's index is
# reported the same way `# @parametrize(...)` reports case indices, so it can be reproduced by
# calling `gen::tuple(generators)(seed)` again with that same `generators` array and the
# reported index as `seed` — not by calling an individual generator directly, since `tuple`
# derives each parameter's actual seed from it.

# Derives a well-spread sub-seed for position `i` under a parent `seed`. Not itself a generator —
# a helper used by every combinator below so that e.g. `tuple`'s per-parameter generators, or
# `array`'s per-element generator, don't all draw from the exact same seed.
def _sub_seed(seed, i):
  seed * 97 + i
end

# A generator producing a uniformly random integer in `[min, max]` (inclusive).
#
# Example:
# ```
# import "gen" | (gen::int(1, 10))(42)
# #=> 6
# ```
#
# Returns: function
def int(min, max):
  fn(seed): rand_int(min, max, seed);
end

# A generator producing a uniformly random float in `[0, 1)`.
#
# Example:
# ```
# import "gen" | is_number((gen::float())(42))
# #=> true
# ```
#
# Returns: function
def float():
  fn(seed): rand(seed);
end

# A generator producing a random boolean.
#
# Example:
# ```
# import "gen" | is_bool((gen::bool())(42))
# #=> true
# ```
#
# Returns: function
def bool():
  fn(seed): rand_int(0, 1, seed) == 1;
end

# A generator producing a random string of `len` characters drawn (with replacement) from
# `charset`.
#
# Example:
# ```
# import "gen" | (gen::string("abc", 5))(42)
# #=> ababc
# ```
#
# Returns: function
def string(charset, len):
  fn(seed): random_string(len, charset, seed);
end

# A generator that always produces `value`, ignoring the seed. Useful alongside generated fields
# in `tuple`/`array`/`one_of` for a value that should stay fixed across every iteration.
#
# Example:
# ```
# import "gen" | (gen::const("literal"))(42)
# #=> literal
# ```
#
# Returns: function
def const(value):
  fn(seed): value;
end

# A generator that picks a uniformly random element from `values`.
#
# Example:
# ```
# import "gen" | (gen::element(["a", "b", "c"]))(42)
# #=> b
# ```
#
# Returns: function
def element(values):
  fn(seed): values[rand_int(0, len(values) - 1, seed)];
end

# A generator that picks one of `gens` (an array of generators) and runs it.
#
# Example:
# ```
# import "gen" | (gen::one_of([gen::const(1), gen::const(2), gen::const(3)]))(42)
# #=> 2
# ```
#
# Returns: function
def one_of(gens):
  fn(seed): gens[rand_int(0, len(gens) - 1, seed)](_sub_seed(seed, 1));
end

# A generator producing a fixed-length array of `len` values, each independently drawn from
# `gen`.
#
# Example:
# ```
# import "gen" | (gen::array(gen::int(0, 9), 5))(42)
# #=> [1, 0, 3, 3, 9]
# ```
#
# Returns: function
def array(gen, len):
  fn(seed): if (len == 0): [] else: map(range(0, len - 1), fn(i): gen(_sub_seed(seed, i)););
end

# A generator producing a variable-length array (`min_len` to `max_len`, inclusive) of values,
# each independently drawn from `gen`.
#
# Example:
# ```
# import "gen" | let arr = (gen::array_of(gen::int(0, 9), 1, 5))(42) | len(arr) >= 1 && len(arr) <= 5
# #=> true
# ```
#
# Returns: function
def array_of(gen, min_len, max_len):
  fn(seed):
    let n = rand_int(min_len, max_len, _sub_seed(seed, 999983))
    | if (n == 0): [] else: map(range(0, n - 1), fn(i): gen(_sub_seed(seed, i)););
end

# A generator that transforms the value `gen` produces through `mapper`. Named `transform`
# rather than `map` so it doesn't shadow the built-in `map` used internally by the other
# combinators in this module.
#
# Example:
# ```
# import "gen" | (gen::transform(gen::int(1, 1), fn(n): n + 100;))(42)
# #=> 101
# ```
#
# Returns: function
def transform(gen, mapper):
  fn(seed): mapper(gen(seed));
end

# A generator producing an array with one value per generator in `gens`, each independently
# seeded. This is what `# @property(count, generators)` calls under the hood to turn an array of
# per-parameter generators into a single argument list per iteration.
#
# Example:
# ```
# import "gen" | (gen::tuple([gen::const(1), gen::const(2)]))(42)
# #=> [1, 2]
# ```
#
# Returns: function
def tuple(gens):
  fn(seed): map(zip(range(0, len(gens)), gens), fn(p): p[1](_sub_seed(seed, p[0])););
end

# ---------------------------------------------------------------------------
# Shrinking
# ---------------------------------------------------------------------------
#
# Shrinking searches for a smaller, simpler failing example once a property test has already
# found *a* failing one, so the reported counterexample is easier to reason about than whatever
# the raw random seed happened to produce. `mq-test`'s `# @property(...)` runner calls `shrink`
# automatically on every failing case; the functions below are also usable directly by
# hand-written property tests that don't go through `# @property(...)`.

# Safety valve on the total number of shrink rounds `shrink` performs, so a pathological value
# (or a property that stays "interesting" for an unbounded chain of ever-smaller candidates)
# can't run away.
def _shrink_max_rounds():
  100
end

# One step of "smaller" candidates for a number, ordered most-aggressive first: straight to
# zero, halfway to zero, or one step closer to zero.
def _shrink_number(n):
  if (n == 0):
    []
  else:
    do
      let sign = if (n < 0): 0 - 1 else: 1
      | let half = trunc(n / 2)
      | let step = n - sign
      | uniq(filter([0, half, step], fn(c): c != n;))
    end
end

# One step of "smaller" candidates for a string or array `seq`, ordered most-aggressive first:
# empty, half-length prefix, or one element/char shorter. `empty` is `""` or `[]` to match
# `seq`'s type.
def _shrink_seq(seq, empty):
  let n = len(seq)
  | if (n == 0):
      []
    else:
      do
        let half = slice(seq, 0, trunc(n / 2))
        | let drop_last = slice(seq, 0, n - 1)
        | uniq(filter([empty, half, drop_last], fn(c): c != seq;))
      end
end

# One candidate array per index of `arr`, each with that single element replaced by the first
# (most aggressive) shrink candidate of its own value. Lets `shrink` simplify elements, not
# just the array's length.
def _shrink_array_elements(arr):
  if (is_empty(arr)):
    []
  else:
    filter(
      map(range(0, len(arr) - 1), fn(i):
        let candidates = shrink_value(arr[i])
        | if (is_empty(candidates)): None else: set(arr, i, candidates[0]);
      ),
      fn(c): not(is_none(c));
    )
end

# One candidate dict per key of `d`, each with that single value replaced by the first (most
# aggressive) shrink candidate of its own value.
def _shrink_dict_values(d):
  filter(
    map(keys(d), fn(k):
      let candidates = shrink_value(d[k])
      | if (is_empty(candidates)): None else: set(d, k, candidates[0]);
    ),
    fn(c): not(is_none(c));
  )
end

# One step of "smaller" candidate values for `value`, dispatched on its runtime type: numbers
# shrink toward `0`, booleans toward `false`, strings and arrays toward shorter/empty (and, for
# arrays, toward simpler elements), dicts toward simpler values (same keys). Anything else
# (`None`, markdown nodes, functions) has no smaller form and shrinks to `[]`.
#
# Example:
# ```
# import "gen" | gen::shrink_value(10)
# #=> [0, 5, 9]
# ```
#
# Returns: array
def shrink_value(value):
  if (is_number(value)):
    _shrink_number(value)
  elif (is_bool(value)):
    if (value): [false] else: []
  elif (is_string(value)):
    _shrink_seq(value, "")
  elif (is_array(value)):
    _shrink_seq(value, []) + _shrink_array_elements(value)
  elif (is_dict(value)):
    _shrink_dict_values(value)
  else:
    []
end

# Every one-step neighbor of `args` (an array of values, e.g. the arguments a failing
# `# @property(...)` case was called with): for each position, one candidate array per value
# `shrink_value` offers for that position, every other position held fixed.
#
# Uses `fold`/`+` instead of `flatten`: `flatten` recurses all the way down, so it would tear
# apart a candidate that's itself an array, or a length-1 `args`'s one-element wrapper array.
def _shrink_neighbors(args):
  fold(
    map(range(0, len(args) - 1), fn(i):
      map(shrink_value(args[i]), fn(v): set(args, i, v););
    ),
    [],
    fn(acc, candidates): acc + candidates;
  )
end

def _shrink_rounds(args, is_interesting, rounds_left):
  if (rounds_left <= 0):
    args
  else:
    do
      let smaller = filter(_shrink_neighbors(args), is_interesting)
      | if (is_empty(smaller)):
          args
        else:
          _shrink_rounds(smaller[0], is_interesting, rounds_left - 1)
    end
end

# Searches `args` (an array of values) for a smaller array still "interesting" per
# `is_interesting` (a `fn(args): bool`, typically "the property still fails for these args").
# Replaces one position at a time with a smaller candidate, stopping at a local minimum or after
# `_shrink_max_rounds()` rounds. Returns `args` unchanged if nothing smaller was interesting.
#
# `is_interesting` should not throw on an out-of-domain candidate (e.g. a value a hand-written
# generator would never actually produce). Wrap it in `try: ... catch: false;` if it might, so a
# stray shrink candidate can't abort the whole search.
#
# Example:
# ```
# import "gen" | gen::shrink([10], fn(a): a[0] > 3;)
# #=> [4]
# ```
#
# Returns: array
def shrink(args, is_interesting):
  _shrink_rounds(args, is_interesting, _shrink_max_rounds())
end
