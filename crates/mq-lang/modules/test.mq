# Testing framework for mq
# A simple testing framework to execute test functions and output results

import "gen"

# Verifies that a condition is true and raises an error if it's false.
#
# Example:
# ```
# true | include "test" | assert(true)
# #=> true
# ```
#
# Returns: dynamic
def assert(cond):
  if (cond):
    self
  else:
    {"error": true, "message": "Assertion failed: It is not true."}
end

# Renders inline diff parts for a delete line (shows equal + deleted chars, highlights deleted)
def _render_inline_delete(inline):
  join(foreach (part, inline):
    let pv = gsub(gsub(part["value"], " ", "·"), "\n", "↵")
    | if (part["tag"] == "delete"):
        pv
      elif (part["tag"] == "equal"):
        pv
      else:
        ""
  end, "")
end

# Renders inline diff parts for an insert line (shows equal + inserted chars, highlights inserted)
def _render_inline_insert(inline):
  join(foreach (part, inline):
    let pv = gsub(gsub(part["value"], " ", "·"), "\n", "↵")
    | if (part["tag"] == "insert"):
        pv
      elif (part["tag"] == "equal"):
        pv
      else:
        ""
  end, "")
end

# Verifies that two values are equal
#
# Example:
# ```
# 1 | include "test" | assert_eq(1, 1)
# #=> 1
# ```
#
# Returns: dynamic
def assert_eq(actual, expected):
  if (actual == expected):
    self
  else:
    do
      let is_array_diff = is_array(expected) && is_array(actual)
      | let diff_res = _diff(expected, actual)
      | let diff_lines = foreach (change, diff_res):
              let tag = change["tag"]
              | let value = change["value"]
              | let text = if (is_string(value)):
                              do
                                let s = gsub(gsub(value, "\n", ""), " ", "·")
                                | if (is_array_diff):
                                    "\"" + s + "\""
                                  else:
                                    s
                              end
                            else:
                              to_string(value)
              | let rendered = if (contains(change, "inline") && not(is_array_diff)):
                              if (tag == "delete"):
                                _render_inline_delete(change["inline"])
                              else:
                                _render_inline_insert(change["inline"])
                            else:
                              text
              | if (tag == "insert"):
                  "+ " + rendered
                elif (tag == "delete"):
                  "- " + rendered
                else:
                  "  " + text
            end
      | let diff_str = join(diff_lines, "\n")
      | {"error": true, "message": "Assertion failed\n\n" + diff_str}
    end
end

# Verifies that two values are not equal
#
# Example:
# ```
# 1 | include "test" | assert_ne(1, 2)
# #=> 1
# ```
#
# Returns: dynamic
def assert_ne(actual, expected):
  if (actual != expected):
    self
  else:
    {"error": true, "message": "Assertion failed: Expected values to be different, but both were " + to_string(actual)}
end

# Verifies that a value is true
#
# Example:
# ```
# true | include "test" | assert_true(true)
# #=> true
# ```
#
# Returns: dynamic
def assert_true(value):
  if (value == true):
    self
  else:
    {"error": true, "message": "Assertion failed: Expected true\n    but got " + to_string(value)}
end

# Verifies that a value is false
#
# Example:
# ```
# false | include "test" | assert_false(false)
# #=> false
# ```
#
# Returns: dynamic
def assert_false(value):
  if (value == false):
    self
  else:
    {"error": true, "message": "Assertion failed: Expected false\n    but got " + to_string(value)}
end

# Verifies that a value is None
#
# Example:
# ```
# None | include "test" | assert_none(None)
# #=> 
# ```
#
# Returns: dynamic
def assert_none(value):
  if (is_none(value)):
    self
  else:
    {"error": true, "message": "Assertion failed: Expected None\n    but got " + to_string(value)}
end

# Verifies that a value is not None
#
# Example:
# ```
# 1 | include "test" | assert_not_none(1)
# #=> 1
# ```
#
# Returns: dynamic
def assert_not_none(value):
  if (not(is_none(value))):
    self
  else:
    {"error": true, "message": "Assertion failed: Expected non-None value but got None"}
end

# Verifies that an array contains a specific value
#
# Example:
# ```
# [1, 2] | include "test" | assert_contains([1, 2], 1)
# #=> [1, 2]
# ```
#
# Returns: dynamic
def assert_contains(array, value):
  if (in(array, value)):
    self
  else:
    {"error": true, "message": "Assertion failed: Array does not contain " + to_string(value)}
end

# Verifies that an array has a specific length
#
# Example:
# ```
# [1, 2] | include "test" | assert_len([1, 2], 2)
# #=> [1, 2]
# ```
#
# Returns: dynamic
def assert_len(array, expected_length):
  let actual_length = len(array)
  | if (actual_length == expected_length):
      self
    else:
      {"error": true, "message": "Assertion failed: Expected length " + to_string(expected_length) + " but got " + to_string(actual_length)}
end

# Verifies that an array is empty
#
# Example:
# ```
# [] | include "test" | assert_empty([])
# #=> []
# ```
#
# Returns: dynamic
def assert_empty(array):
  if (is_empty(array)):
    self
  else:
    {"error": true, "message": "Assertion failed: Expected empty array but got " + to_string(array)}
end

# Verifies that an array is not empty
#
# Example:
# ```
# [1] | include "test" | assert_not_empty([1])
# #=> [1]
# ```
#
# Returns: dynamic
def assert_not_empty(array):
  if (not(is_empty(array))):
    self
  else:
    {"error": true, "message": "Assertion failed: Expected non-empty array but got empty array"}
end

# Verifies that a value has the given type.
#
# For markdown nodes this checks the node kind (e.g. "h1", "code", "list"),
# matching `to_md_name`. For every other value it checks the runtime type
# returned by `type`. On failure the source range of `value` is included
# so callers (e.g. content-lint rules) can point at the offending node.
#
# Example:
# ```
# 1 | include "test" | assert_type(1, "number")
# #=> 1
# ```
#
# Returns: dynamic
def assert_type(value, expected_type):
  let actual_type = if (is_markdown(value)): to_md_name(value) else: type(value)
  | if (actual_type == expected_type):
      value
    else:
      {"error": true, "range": get_location(value), "message": "Assertion failed: expected type \"" + expected_type + "\" but got \"" + actual_type + "\""}
end

# Verifies that a dict has the given field.
#
# Example:
# ```
# {"a": 1} | include "test" | assert_field({"a": 1}, "a")
# #=> {"a": 1}
# ```
#
# Returns: dynamic
def assert_field(value, field):
  if (is_dict(value) && contains(value, field)):
    value
  elif (not(is_dict(value))):
    {"error": true, "range": get_location(value), "message": "Assertion failed: expected a dict but got \"" + type(value) + "\""}
  else:
    {"error": true, "range": get_location(value), "message": "Assertion failed: expected field \"" + field + "\" to exist"}
end

# Verifies that a value's string representation matches the given regular expression pattern.
#
# Example:
# ```
# "abc" | include "test" | assert_matches("abc", "a.c")
# #=> abc
# ```
#
# Returns: dynamic
def assert_matches(value, pattern):
  if (test(to_string(value), pattern)):
    value
  else:
    {"error": true, "range": get_location(value), "message": "Assertion failed: expected \"" + to_string(value) + "\" to match pattern \"" + pattern + "\""}
end

# Test execution helper functions

# Runs a single test function and captures the result
def _run_test(test_name, test_func):
  let test_count = 1
  | let start_time = now()
  | let result = test_func()
  | let end_time = now()
  | let duration = end_time - start_time
  | if (is_dict(result) && contains(result, "error")):
      {
        "name": test_name,
        "status": "failed",
        "duration": duration,
        "error": result["message"]
      }
    else:
      {
        "name": test_name,
        "status": "passed",
        "duration": duration,
        "error": None
      }
end

# Formats duration as X.XXXs
def _format_duration(duration_ms):
  let duration_s = duration_ms / 1000
  | let duration_str = to_string(duration_s)
  | let duration_str = if (contains(duration_str, ".")):
      duration_str
    else:
      duration_str + ".0"
  | let duration_split = split(duration_str, ".")
  | let duration_str = if (len(duration_split[1]) == 1):
      duration_str + "00"
    elif (len(duration_split[1]) == 2):
      duration_str + "0"
    else:
      duration_str
  | duration_str + "s"
end

# Runs each test in `tests` (dicts with `name`/`func`, as built by `test_case`) and returns
# one result dict per test: `name`, `status` ("passed"/"failed"), `duration` (ms), `error`
# (failure message, or None), and `row` (the pre-rendered Markdown report row used by
# `run_tests`). Shared by `run_tests` (Markdown report) and `run_tests_data` (raw results).
def _run_tests_results(tests):
  foreach (test, tests):
      if (is_dict(test) && contains(test, "name") && contains(test, "func")):
        do
          let result = _run_test(get(test, "name"), get(test, "func"))
          | let duration_str = _format_duration(result["duration"])
          | let status_str = if (result["status"] == "passed"): "✅" else: "❌"
          | let row = "| " + status_str + " | `" + duration_str + "` | " + result["name"] + " |"
          | {"name": result["name"], "status": result["status"], "duration": result["duration"], "error": result["error"], "row": row}
        end
      else:
        error("Invalid test format: each test must be a dict with 'name' and 'func' keys")
    end
end

# Executes multiple test functions.
#
# The whole report is built as a single string and printed with one `print`
# call, so concurrently running test files (the Rust runner may evaluate
# several files in parallel) can never interleave their output mid-line.
# Returns `true` if every test passed, so the caller can aggregate pass/fail
# across files itself instead of this function terminating the process.
#
# Returns: bool
def run_tests(tests):
  let final_test_count = len(tests)
  | let file_name = try: TEST_FILE catch: ""
  | let header = "# " + file_name + "\n\nStarting " + to_string(final_test_count) + " tests...\n\n" +
      "| Status | Duration | Test Name |\n| :--- | :--- | :--- |"
  | let test_results = _run_tests_results(tests)
  | let rows = join(map(test_results, fn(r): r["row"];), "\n")
  | let final_failed_count = len(filter(test_results, fn(r): r["status"] == "failed";))
  | let passed_count = final_test_count - final_failed_count
  | let total_duration = fold(map(test_results, fn(r): r["duration"];), 0, fn(acc, d): acc + d;)

  # Build the failures section, if any
  | let failures_section = if (final_failed_count > 0):
      do
        let failures = filter(test_results, fn(r): r["status"] == "failed";)
        | let failure_blocks = foreach (failure, failures):
            let error_parts = split(failure["error"], "\n\n")
            | let failure_header = "❌ " + error_parts[0]
            | let has_body = len(error_parts) > 1
            | let body = if (has_body):
                "\n```diff\n" + join(skip(error_parts, 1), "\n") + "\n```"
              else:
                ""
            | "### " + failure["name"] + "\n" + failure_header + body
          end
        | "\n## Failures\n\n" + join(failure_blocks, "\n\n") + "\n"
      end
    else:
      ""

  # Build the summary section
  | let summary_duration = _format_duration(total_duration)
  | let passed_str = "✅ " + to_string(passed_count)
  | let failed_str = "❌ " + to_string(final_failed_count)
  | let summary = "\n## Summary\n\n| Duration | Tests | Passed | Failed |\n| :--- | :--- | :--- | :--- |\n" +
      "| `" + summary_duration + "` | " + to_string(final_test_count) + " | " + passed_str + " | " + failed_str + " |\n\n---\n"

  | let _ = print(header + "\n" + rows + "\n" + failures_section + summary)

  | final_failed_count == 0
end

# Like `run_tests`, but returns the per-test result dicts (`name`, `status`, `duration`,
# `error`) instead of printing a Markdown report. Used by `mq-test --format json` so the
# caller can build its own machine-readable report.
#
# Example:
# ```
# None | include "test" | run_tests_data([test_case("t", fn(): true;)])[0]["status"]
# #=> passed
# ```
#
# Returns: array<dict>
def run_tests_data(tests):
  map(_run_tests_results(tests), fn(r): {"name": r["name"], "status": r["status"], "duration": r["duration"], "error": r["error"]};)
end

# Helper function to create a test case
#
# Example:
# ```
# include "test" | test_case("my test", fn(): true;)["name"]
# #=> my test
# ```
#
# Returns: dict
def test_case(name, func):
  {
    "name": name,
    "func": func
  }
end

# `gen::shrink`'s `is_interesting` predicate for a `# @property(...)` case: re-runs `adapter`
# (see `_property_case_result`) on shrink candidate `a` and reports whether it still fails.
# Treats a thrown error as "not interesting" instead of letting it propagate, so a shrink
# candidate outside the generators' actual domain (e.g. a divisor shrunk down to `0`) can't
# abort the whole shrink search.
def _property_case_still_fails(adapter, a):
  try:
    do
      let r = adapter(a)
      | is_dict(r) && contains(r, "error")
    end
  catch:
    false;

# Runs a single `# @property(...)` case. `adapter` wraps the property function as a
# `fn(args): result` taking one array argument instead of one per parameter (see
# `TestRunner::build_test_query` in `mq-test`). `args` is that iteration's generated arguments,
# from `gen::tuple(generators)(seed)`.
#
# On failure, searches for a smaller failing `args` with `gen::shrink` before reporting, so the
# failure message shows a minimal counterexample. The case name still reports the original seed
# (`name[seed]`), so the unshrunk case stays reproducible via `gen::tuple(generators)(seed)`.
#
# Returns: dict
def _property_case_result(args, adapter):
  let result = adapter(args)
  | if (is_dict(result) && contains(result, "error")):
      do
        let shrunk = gen::shrink(args, fn(a): _property_case_still_fails(adapter, a);)
        | if (shrunk == args):
            result
          else:
            do
              let shrunk_result = adapter(shrunk)
              | {
                  "error": true,
                  "message": shrunk_result["message"] + "\n\nShrunk from " + to_string(args) + " to " + to_string(shrunk)
                }
            end
      end
    else:
      result
end


