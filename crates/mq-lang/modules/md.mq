# Builder functions for constructing markdown nodes from scratch, plus utilities for
# indexing and resolving reference-style links, images, and footnotes.
# This module is under development. APIs and behavior may change without notice.
#
# `md::reference_index` and `md::resolve_references` need every document node at
# once — pass `-A` on the CLI, or pipe through `nodes` in an inline query/script;
# a single node instead prints a stderr warning and is treated as a one-element array.

# Wraps `value` in a heading node at the given `depth` (1-6).
#
# Example:
# ```
# import "md" | md::h("Title", 1)
# #=> # Title
# ```
#
# Returns: markdown
def h(value, depth): to_h(value, depth);

# Wraps `value` in a fenced code block with the given `lang`.
#
# Returns: markdown
def code(value, lang): to_code(value, lang);

# Wraps `value` in an inline code span.
#
# Example:
# ```
# import "md" | md::code_inline("x")
# #=> `x`
# ```
#
# Returns: markdown
def code_inline(value): to_code_inline(value);

# Creates a plain text node from `value`.
#
# Example:
# ```
# import "md" | md::text("hi")
# #=> hi
# ```
#
# Returns: markdown
def text(value): to_md_text(value);

# Wraps `value` in a strong (bold) node.
#
# Example:
# ```
# import "md" | md::strong("Bold")
# #=> **Bold**
# ```
#
# Returns: markdown
def strong(value): to_strong(value);

# Wraps `value` in an emphasis (italic) node.
#
# Example:
# ```
# import "md" | md::em("Italic")
# #=> *Italic*
# ```
#
# Returns: markdown
def em(value): to_em(value);

# Wraps `value` in a delete (strikethrough) node.
#
# Example:
# ```
# import "md" | md::delete("Old")
# #=> ~~Old~~
# ```
#
# Returns: markdown
def delete(value): to_delete(value);

# Wraps `value` in a blockquote node.
#
# Example:
# ```
# import "md" | md::blockquote("Quote")
# #=> > Quote
# ```
#
# Returns: markdown
def blockquote(value): to_blockquote(value);

# Wraps `value` in a callout node of the given `kind` (e.g. "note", "warning"),
# with an optional custom `title`.
#
# Example:
# ```
# import "md" | md::callout("Note text", "note", "")
# #=> > [!NOTE]
# > Note text
# ```
#
# Returns: markdown
def callout(value, kind, title = ""): to_callout(value, kind, title);

# Creates a horizontal rule node.
#
# Example:
# ```
# import "md" | md::hr()
# #=> ***
# ```
#
# Returns: markdown
def hr(): to_hr();

# Creates a blank line between the surrounding elements in a `doc()`/`to_md_fragment()` call.
#
# Returns: markdown
def br(): to_md_text("");

# Wraps `value` in a math block node.
#
# Example:
# ```
# import "md" | md::math("x^2")
# #=> $$
# x^2
# $$
# ```
#
# Returns: markdown
def math(value): to_math(value);

# Wraps `value` in an inline math node.
#
# Example:
# ```
# import "md" | md::math_inline("x^2")
# #=> $x^2$
# ```
#
# Returns: markdown
def math_inline(value): to_math_inline(value);

# Creates a link node pointing to `url` with link text `value` and an optional `title`.
#
# Example:
# ```
# import "md" | md::link("https://example.com", "Example", "")
# #=> [Example](https://example.com)
# ```
#
# Returns: markdown
def link(url, value, title = ""): to_link(url, value, title);

# Creates an image node pointing to `url` with `alt` text and an optional `title`.
#
# Example:
# ```
# import "md" | md::image("https://example.com/a.png", "Alt", "")
# #=> ![Alt](https://example.com/a.png "")
# ```
#
# Returns: markdown
def image(url, alt, title = ""): to_image(url, alt, title);

# Wraps `value` in a footnote definition node identified by `ident`.
#
# Example:
# ```
# import "md" | md::footnote("Footnote text", "1")
# #=> [^1]: Footnote text
# ```
#
# Returns: markdown
def footnote(value, ident): to_footnote(value, ident);

# Creates a footnote reference node pointing at `ident`.
#
# Example:
# ```
# import "md" | md::footnote_ref("1")
# #=> [^1]
# ```
#
# Returns: markdown
def footnote_ref(ident): to_footnote_ref(ident);

# Creates a link reference definition node (`[ident]: url "title"`) for `ident`,
# with an optional `title`.
#
# Example:
# ```
# import "md" | md::definition("https://example.com", "ex", "")
# #=> [ex]: https://example.com
# ```
#
# Returns: markdown
def definition(url, ident, title = ""): to_definition(url, ident, title);

# Wraps `value` in a raw HTML node, emitted as-is.
#
# Example:
# ```
# import "md" | md::html("<br>")
# #=> <br>
# ```
#
# Returns: markdown
def html(value): to_md_html(value);

# Creates a hard line break node.
#
# Returns: markdown
def linebreak(): to_break();

# Wraps `value` in a list item node at the given `level` (0-indexed nesting), optionally
# `ordered` (numbered) and/or `checked` (checkbox); pass `checked = None` for a plain item.
#
# Example:
# ```
# import "md" | md::list("Item", 0)
# #=> - Item
# ```
#
# Returns: markdown
def list(value, level = 0, ordered = false, checked = None):
  to_md_list(value, level) | set_list_ordered(ordered) | set_check(checked);

# Creates a table row node from an array of cell values.
#
# Example:
# ```
# import "md" | md::table_row(["a", "b"])
# #=> |a|b|
# ```
#
# Returns: markdown
def table_row(cells): to_md_table_row(cells);

# Creates a single table cell node at the given `row`/`column`.
#
# Example:
# ```
# import "md" | md::table_cell("A1", 0, 0)
# #=> A1
# ```
#
# Returns: markdown
def table_cell(value, row, column): to_md_table_cell(value, row, column);

# Creates a table alignment (header separator) row node from an array of alignments
# (e.g. ["left", "right", "center"]).
#
# Example:
# ```
# import "md" | md::table_align(["left", "right"])
# #=> |:---|---:|
# ```
#
# Returns: markdown
def table_align(aligns): to_md_table_align(aligns);

# Builds a full table from a `header` array of cell values and a `rows` array of
# row arrays. `aligns` is an array of alignment strings (e.g. ["left", "right",
# "center"]) matching `header`'s length; defaults to no alignment. Returns an
# array of row/align nodes ready to splice into `doc()`.
#
# Example:
# ```
# import "md" | md::doc(md::table(["A", "B"], [["1", "2"], ["3", "4"]]))
# #=> |A|B|
# |---|---|
# |1|2|
# |3|4|
# ```
#
# Returns: array
def table(header, rows, aligns = []):
  let aligns = if (is_empty(aligns)): map(header, fn(_): "none";) else: aligns
  | [table_row(header), table_align(aligns)] + map(rows, table_row);

# Combines markdown nodes into a single markdown value. Accepts either a variable
# number of arguments (`doc(a, b, c)`) or a single array (`doc([a, b, c])`). Nested
# arrays (e.g. from `map()`) are flattened automatically, so components can return
# plain arrays of nodes and be spliced in as children.
#
# Example:
# ```
# import "md" | md::doc(md::h("T", 1), md::text("hi"))
# #=> # T
# hi
# ```
#
# Returns: markdown
def doc(*values): to_md_fragment(values);

def _is_definition(md): to_md_name(md) == "definition";
def _is_footnote_def(md): to_md_name(md) == "footnote";
def _is_link_ref(md): to_md_name(md) == "link_ref";
def _is_image_ref(md): to_md_name(md) == "image_ref";
def _is_footnote_ref(md): to_md_name(md) == "footnoteref";

# Normalizes input into an array of Markdown nodes, for the same reason as
# `section::_ensure_aggregated`: reference indexing/resolution needs the full
# document, so a bare single node (missing `-A`/`nodes`) is warned about and
# wrapped in a one-element array instead of silently producing nonsense.
def _ensure_aggregated(md_nodes):
  if (is_array(md_nodes)):
    md_nodes
  else:
    do
      [md_nodes] | stderr("mq: reference functions expect all document nodes; got a single node. Pass `-A` on the command line or pipe through `nodes` first.")
    end
end

def _link_def_entry(d):
  {ident: attr(d, "ident"), label: attr(d, "label"), url: attr(d, "url"), title: attr(d, "title"), location: get_location(d)}
end

def _footnote_def_entry(d):
  {ident: attr(d, "ident"), location: get_location(d)}
end

# Scans `md_nodes` for link reference definitions (`[ident]: url "title"`) and
# footnote definitions (`[^ident]: ...`), and indexes them by identifier. Each
# identifier maps to an array of every definition found for it, in document
# order, so a duplicate definition (multiple `[ident]:` lines for the same
# `ident`) shows up as an array with more than one entry — CommonMark resolves
# such a duplicate to the first one, which `md::resolve_references` picks.
# Each entry carries its `location` (from `get_location`) for building
# diagnostics like linkcheck output.
#
# Example:
# ```
# import "md" | len(md::reference_index(to_markdown("[a][b]\n\n[b]: https://example.com \"B\""))[:links]["b"])
# #=> 1
# ```
# Example:
# ```
# import "md" | len(md::reference_index(to_markdown("[a][b]\n\n[b]: https://x.com\n[b]: https://y.com"))[:links]["b"])
# #=> 2
# ```
#
# Returns: dict
def reference_index(md_nodes):
  let agg_nodes = _ensure_aggregated(md_nodes)
  | let link_groups = group_by(filter(agg_nodes, _is_definition), fn(d): attr(d, "ident");)
  | let footnote_groups = group_by(filter(agg_nodes, _is_footnote_def), fn(d): attr(d, "ident");)
  | {
      links: map(link_groups, fn(e): [e[0], map(e[1], _link_def_entry)];),
      footnotes: map(footnote_groups, fn(e): [e[0], map(e[1], _footnote_def_entry)];)
    }
end

def _resolve_ref(n, idx):
  let table = if (_is_footnote_ref(n)): get_or(idx, :footnotes, dict()) else: get_or(idx, :links, dict())
  | let ident = attr(n, "ident")
  | let defs = get_or(table, ident, [])
  | let resolved = !is_empty(defs)
  | {
      type: to_md_name(n),
      ident: ident,
      label: attr(n, "label"),
      location: get_location(n),
      resolved: resolved,
      duplicate: len(defs) > 1,
      definition: if (resolved): first(defs) else: None,
      definitions: defs
    }
end

# Resolves every reference-style link (`[text][ident]`, including the shortcut
# form `[ident]`), reference image (`![alt][ident]`), and footnote reference
# (`[^ident]`) found in `md_nodes` against a reference index, returning one
# dict per reference with its `type`, `ident`, `label`, `location`, whether it
# `resolved` to a definition, whether that definition is `duplicate` (more
# than one `[ident]:` for the same identifier), the `definition` picked
# (CommonMark's first-match-wins, or `None` if unresolved), and every
# candidate `definitions`.
#
# `index` defaults to `md::reference_index(md_nodes)`, resolving references
# against their own document. Pass an explicit index (e.g. built from a
# different set of nodes) to resolve references that got separated from their
# definitions — for example when a document is split or a section is moved
# into another file — which is exactly the case where a reference legitimately
# comes back unresolved.
#
# Example:
# ```
# import "md" | first(md::resolve_references(to_markdown("[a][b]\n\n[b]: https://example.com")))[:resolved]
# #=> true
# ```
# Example:
# ```
# import "md" | first(md::resolve_references(to_markdown("[a][b]\n\n[b]: https://example.com"), dict()))[:resolved]
# #=> false
# ```
#
# Returns: array
def resolve_references(md_nodes, index = None):
  let agg_nodes = _ensure_aggregated(md_nodes)
  | let idx = if (is_none(index)): reference_index(agg_nodes) else: index
  | let refs = filter(agg_nodes, fn(n): _is_link_ref(n) || _is_image_ref(n) || _is_footnote_ref(n);)
  | map(refs, fn(n): _resolve_ref(n, idx);)
end
