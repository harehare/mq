import "gron"
| import "gen"
| include "test"

# -- gron Tests --

def test_gron_parse_scalar():
  let result = gron::gron_parse("json = \"hello\";")
  | assert_eq(result, "hello")
end

# @parametrize([["json = {};\njson.a = {};\njson.a.b = \"deep\";", "deep"], ["json.a.b = \"deep\";", "deep"]])
def test_gron_parse_nested(input, expected):
  let result = gron::gron_parse(input)
  | assert_eq(result["a"]["b"], expected)
end

def test_gron_parse_array():
  let result = gron::gron_parse("json = [];\njson[0] = \"x\";\njson[1] = \"y\";")
  | assert_eq(result, ["x", "y"])
end

# @parametrize([
# ["hello", "json = \"hello\";"],
# [{"a": {"b": "deep"}}, "json = {};\njson.a = {};\njson.a.b = \"deep\";"],
# [["x", "y"], "json = [];\njson[0] = \"x\";\njson[1] = \"y\";"],
# [{}, "json = {};"],
# [[], "json = [];"],
# [{"weird key": "v"}, "json = {};\njson[\"weird key\"] = \"v\";"],
# [{"b": 1, "a": 2}, "json = {};\njson.a = 2;\njson.b = 1;"],
# ])
def test_gron_stringify(value, expected):
  assert_eq(gron::gron_stringify(value), expected)
end

# @parametrize([[{"a": 1, "b": [2, 3]}], [["x", {"y": 1}]], [{"a": {"b": {"c": 1}}}]])
def test_gron_stringify_round_trips_with_parse(value):
  let result = gron::gron_stringify(value)
  | assert_eq(gron::gron_parse(result), value)
end

# Leaf values go through `json::json_stringify`, so the charset here mirrors json_test.mq's
# round-trip property (quotes/backslashes/newlines/tabs included) to exercise that escaping too.
# @property(50, [gen::string("abc XYZ012\"\\\n\t", 8), gen::int(-1000000, 1000000), gen::bool()])
def test_gron_stringify_parse_round_trip(s, n, b):
  let value = {"s": s, "n": n, "b": b, "nested": {"arr": [n, b], "s2": s}}
  | assert_eq(gron::gron_parse(gron::gron_stringify(value)), value)
end
