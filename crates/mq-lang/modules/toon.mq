# TOON implementation in mq

# To convert a data structure into a TOON string
#
# Example:
# ```
# import "toon" | toon::toon_stringify({"a": 1})
# #=> a: 1
# ```
#
# Returns: string
def toon_stringify(data): _toon_stringify(data);

# To parse a TOON string into a data structure
#
# Example:
# ```
# import "toon" | toon::toon_parse(toon::toon_stringify({"a": 1}))
# #=> {"a": 1}
# ```
#
# Returns: dynamic
def toon_parse(input):
  _toon_parse(to_string(input))
end

# Parses a TOON string without raising on invalid input.
#
# Example:
# ```
# import "toon" | toon::toon_try_parse(toon::toon_stringify({"a": 1}))["ok"]
# #=> true
# ```
# Example:
# ```
# import "toon" | toon::toon_try_parse(": : :")["ok"]
# #=> false
# ```
#
# Returns: dict
def toon_try_parse(input):
  try: {ok: true, value: toon_parse(input), error: None}
  catch(e): {ok: false, value: None, error: {message: e["message"]}}
end
