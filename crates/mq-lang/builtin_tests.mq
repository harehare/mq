# ])
def test_in(value, needle, expected):
  let result = in(value, needle)
  | assert_eq(result, expected)
end

# @parametrize([
#   [[1, 2, 3, 4, 5], 0, fn(acc, x): acc + x;, 15],
#   [[1, 2, 3], 1, fn(acc, x): acc * x;, 6],
#   [[], 10, fn(acc, x): acc + x;, 10],
# ])
def test_fold(value, init, f, expected):
  let result = fold(value, init, f)
  | assert_eq(result, expected)
end

# Elements that are themselves arrays (e.g. [[1, 2], [3, 4], [1, 2]]) must be
# kept as single elements, not concatenated/flattened into the result (`+`
# on two arrays concatenates, so appending must wrap the element in [item]).
# @parametrize([
#   [[1, 2, 3, 2, 1, 4], fn(x): x;, [1, 2, 3, 4]],
#   [[{"id": 1}, {"id": 2}, {"id": 1}], fn(x): x["id"];, [{"id": 1}, {"id": 2}]],
#   [[], fn(x): x;, []],
#   [[[1, 2], [3, 4], [1, 2]], fn(row): row;, [[1, 2], [3, 4]]],
# ])
def test_unique_by(value, f, expected):
  let result = unique_by(value, f)
  | assert_eq(result, expected)
end

# @parametrize([
#   [[1, 2, 3], [2, 3, 4], [1, 2, 3, 4]],
#   [[1, 1, 2], [2, 2, 3], [1, 2, 3]],
#   [[], [1, 2], [1, 2]],
#   [["a", "b"], ["b", "c"], ["a", "b", "c"]],
# ])
def test_union(value1, value2, expected):
  let result = union(value1, value2)
  | assert_eq(result, expected)
end

# @parametrize([
#   [[1, 2, 3], [2, 3, 4], [2, 3]],
#   [[1, 2], [3, 4], []],
#   [[], [1, 2], []],
#   [["a", "b"], ["b", "c"], ["b"]],
# ])
def test_intersection(value1, value2, expected):
  let result = intersection(value1, value2)
  | assert_eq(result, expected)
end

# @parametrize([
#   [[1, 2, 3], [2, 3, 4], [1]],
#   [[1, 2, 2, 3], [], [1, 2, 3]],
#   [[], [1, 2], []],
#   [["a", "b"], ["b", "c"], ["a"]],
# ])
def test_difference(value1, value2, expected):
  let result = difference(value1, value2)
  | assert_eq(result, expected)
end

# @parametrize([[42, 42], ["test", "test"], [[1, 2, 3], [1, 2, 3]]])
def test_identity(value, expected):
  let result = identity(value)
  | assert_eq(result, expected)
end

# @parametrize([[5, 0, 10, 5], [15, 0, 10, 10], [-5, 0, 10, 0], [0, 0, 10, 0], [10, 0, 10, 10]])
def test_clamp(value, lo, hi, expected):
  let result = clamp(value, lo, hi)
  | assert_eq(result, expected)
end

# @parametrize([
#   [[[1, 2, 3], [4, 5, 6]], [[1, 4], [2, 5], [3, 6]]],
#   [[], []],
#   [[[1, 2], [3, 4], [5, 6]], [[1, 3, 5], [2, 4, 6]]],
# ])
def test_transpose(value, expected):
  let result = transpose(value)
  | assert_eq(result, expected)
end

# @parametrize([[[[1, 2], [3, 4]], [[1, 3], [1, 4], [2, 3], [2, 4]]], [[], [[]]], [[[1]], [[1]]], [[[1, 2], []], []]])
def test_combinations(value, expected):
  let result = combinations(value)
  | assert_eq(result, expected)
end

# @parametrize([["aaa", "[a-z]+", true], ["aaa", "[0-9]+", false]])
def test_regex_test(value, pattern, expected):
  let result = test(value, pattern)
  | assert_eq(result, expected)
end

# @parametrize([["aaa", "[a-z]+", ["aaa"]], ["aaa", "[0-9]+", []]])
def test_regex_match(value, pattern, expected):
  let result = regex_match(value, pattern)
  | assert_eq(result, expected)
end

def test_tap():
  let result1 = tap(1, print("tap"))
  | assert_eq(result1, 1)
end

def test_unless():
  let result1 = unless (false): 1
  | assert_eq(result1, 1)

  | let result2 = unless (true): 1
  | assert_eq(result2, None)
end

def test_pluck():
  let result1 = do to_markdown("# test1\n\n## test2") | pluck(.h.value);
  | assert_eq(result1, ["test1", "test2"])

  | let result2 = do to_markdown("# test1\n\n## test2") | pluck(.h.level);
  | assert_eq(result2, [1, 2])

  | let result3 = do [{name: "test1"}, {name: "test2"}] | pluck(:name);
  | assert_eq(result3, ["test1", "test2"])

  | let result4 = pluck([{"a": 1}, {"a": 2}], "a")
  | assert_eq(result4, [1, 2])

  | let result5 = pluck([{"a": 1}, {"a": 2}], :a)
  | assert_eq(result5, [1, 2])
end

def test_until():
  let result1 = do var i = 0 | until (i == 5): i = i + 1 | i + 1;;
  | assert_eq(result1, 6)
end

# @parametrize([
#   [[1, 2, 3, 4, 5], fn(x): if (x > 2): x;, [3, 4, 5]],
#   [[1, 2, 3], fn(x): if (x % 2 == 0): x * 2;, [4]],
#   [[], fn(x): x;, []],
#   [[1, 2, 3], fn(x): None;, []],
# ])
def test_compact_map(value, f, expected):
  let result = compact_map(value, f)
  | assert_eq(result, expected)
end

# @parametrize([
#   [[1, 2, 3, 4, 5], fn(x): x > 3;, [1, 2, 3]],
#   [[1, 2, 3, 4], fn(x): x % 2 == 0;, [1, 3]],
#   [[], fn(x): x > 0;, []],
#   [[1, 2, 3], fn(x): false;, [1, 2, 3]],
# ])
def test_reject(value, f, expected):
  let result = reject(value, f)
  | assert_eq(result, expected)
end

# @parametrize([
#   [[1, 2, 3, 4, 5], fn(x): x > 3;, [[4, 5], [1, 2, 3]]],
#   [[1, 2, 3, 4], fn(x): x % 2 == 0;, [[2, 4], [1, 3]]],
#   [[], fn(x): x > 0;, [[], []]],
#   [[1, 2, 3], fn(x): true;, [[1, 2, 3], []]],
# ])
def test_partition(value, f, expected):
  let result = partition(value, f)
  | assert_eq(result, expected)
end

# @parametrize([
#   [dict([["a", 1], ["b", 2]]), "a", 0, 1],
#   [dict([["a", 1], ["b", 2]]), "c", 0, 0],
#   [dict([["a", 1], ["b", 2]]), "b", 999, 2],
#   [dict(), "key", "default", "default"],
# ])
def test_get_or(d, key, default, expected):
  let result = get_or(d, key, default)
  | assert_eq(result, expected)
end

# @parametrize([[5, 1, 10, true], [0, 1, 10, false], [10, 1, 10, true], [1, 1, 10, true], [15, 1, 10, false]])
def test_between(value, lo, hi, expected):
  let result = between(value, lo, hi)
  | assert_eq(result, expected)
end

# @parametrize([
#   [[1, 2, 3, 4], fn(x): x;, 10],
#   [[1, 2, 3], fn(x): x * 2;, 12],
#   [[], fn(x): x;, 0],
#   [[5, 10, 15], fn(x): x / 5;, 6],
# ])
def test_sum_by(value, f, expected):
  let result = sum_by(value, f)
  | assert_eq(result, expected)
end

# @parametrize([
#   [[{"id": 1, "name": "Alice"}, {"id": 2, "name": "Bob"}], fn(item): item["id"];, {"1": {"id": 1, "name": "Alice"}, "2": {"id": 2, "name": "Bob"}}],
#   [[], fn(item): item["id"];, dict()],
# ])
def test_index_by(value, f, expected):
  let result = index_by(value, f)
  | assert_eq(result, expected)
end

def test_join_by_inner():
  let left = [{"id": 1, "name": "alice"}, {"id": 2, "name": "bob"}]
  | let right = [{"uid": 2, "age": 30}, {"uid": 3, "age": 40}]
  | let result = join_by(left, right, "id", "uid")
  | assert_eq(result, [{"id": 2, "name": "bob", "uid": 2, "age": 30}])
end

def test_join_by_left_fills_missing_with_none():
  let left = [{"id": 1, "name": "alice"}, {"id": 2, "name": "bob"}]
  | let right = [{"uid": 2, "age": 30}]
  | let result = join_by(left, right, "id", "uid", "left")
  | assert_eq(len(result), 2)
  | assert_eq(result[0], {"id": 1, "name": "alice", "uid": None, "age": None})
  | assert_eq(result[1], {"id": 2, "name": "bob", "uid": 2, "age": 30})
end

def test_join_by_right_fills_missing_with_none():
  let left = [{"id": 2, "name": "bob"}]
  | let right = [{"uid": 2, "age": 30}, {"uid": 3, "age": 40}]
  | let result = join_by(left, right, "id", "uid", "right")
  | assert_eq(len(result), 2)
  | assert_eq(result[0], {"id": 2, "name": "bob", "uid": 2, "age": 30})
  | assert_eq(result[1], {"id": None, "name": None, "uid": 3, "age": 40})
end

def test_join_by_full_fills_both_sides():
  let left = [{"id": 1, "name": "alice"}, {"id": 2, "name": "bob"}]
  | let right = [{"uid": 2, "age": 30}, {"uid": 3, "age": 40}]
  | let result = join_by(left, right, "id", "uid", "full")
  | assert_eq(len(result), 3)
  | assert_eq(result[0], {"id": 1, "name": "alice", "uid": None, "age": None})
  | assert_eq(result[1], {"id": 2, "name": "bob", "uid": 2, "age": 30})
  | assert_eq(result[2], {"id": None, "name": None, "uid": 3, "age": 40})
end

def test_join_by_many_to_many_cross_product():
  let left = [{"id": 1, "l": "l1"}, {"id": 1, "l": "l2"}]
  | let right = [{"id": 1, "r": "r1"}, {"id": 1, "r": "r2"}]
  | let result = join_by(left, right, "id", "id")
  | assert_eq(len(result), 4)
  | assert_eq(result[0], {"id": 1, "l": "l1", "r": "r1"})
  | assert_eq(result[1], {"id": 1, "l": "l1", "r": "r2"})
  | assert_eq(result[2], {"id": 1, "l": "l2", "r": "r1"})
  | assert_eq(result[3], {"id": 1, "l": "l2", "r": "r2"})
end

def test_join_by_field_collision_right_wins():
  let left = [{"id": 1, "value": "from_left"}]
  | let right = [{"id": 1, "value": "from_right"}]
  | let result = join_by(left, right, "id", "id")
  | assert_eq(result, [{"id": 1, "value": "from_right"}])
end

def test_join_by_none_keys_never_match():
  let left = [{"id": None, "name": "alice"}]
  | let right = [{"uid": None, "age": 30}]
  | let result = join_by(left, right, "id", "uid")
  | assert_eq(result, [])
end

def test_join_by_missing_keys_never_match():
  let left = [{"name": "alice"}]
  | let right = [{"age": 30}]
  | let result = join_by(left, right, "id", "uid", "full")
  | assert_eq(len(result), 2)
  | assert_eq(result[0], {"name": "alice", "age": None})
  | assert_eq(result[1], {"name": None, "age": 30})
end

def test_join_by_invalid_kind():
  let result = try: join_by([], [], "id", "uid", "outer") catch(e): e["message"]
  | assert(contains(result, "invalid kind"))
end

def test_join_by_non_array_left_errors():
  let result = try: join_by("nope", [], "id", "uid") catch(e): e["message"]
  | assert(contains(result, "left must be an array"))
end

