# @parametrize([[[1, 2, 3, 4, 5], 3], [[], None], [[10, 20], 15]])
def test_mean(value, expected):
  let result = mean(value)
  | assert_eq(result, expected)
end

def test_mean_coroutine():
  let source = fn(): yield: 1 | yield: 2 | yield: 3;
  | assert_eq(mean(source()), 2)
end

def test_geomean():
  let result1 = geomean([1, 2, 4])
  | assert_eq(round(result1 * 100) / 100, 2)

  | let result2 = geomean([])
  | assert_eq(result2, None)

  | let result3 = geomean([2, 8])
  | assert_eq(result3, 4)
end

