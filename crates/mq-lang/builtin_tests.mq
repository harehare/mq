  | assert_eq(result, expected)
end

# @parametrize([[0, "0B"], [500, "500B"], [1536, "1.5K"], [1048576, "1M"], [1610612736, "1.5G"], [-1536, "-1.5K"]])
def test_human_size(value, expected):
  let result = human_size(value)
  | assert_eq(result, expected)
