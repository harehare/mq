def test_numbers(value, expected):
  let result = numbers(value)
  | assert_eq(result, expected)
end

# @parametrize([["hello", "hello"], [42, None]])
def test_strings(value, expected):
  let result = strings(value)
  | assert_eq(result, expected)
end

