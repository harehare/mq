# @parametrize([
#   ["---\ntitle: Hello\nauthor: World\n---\n\n# Heading", {"title": "Hello", "author": "World"}],
#   ["+++\ntitle = \"Hello\"\nauthor = \"World\"\n+++\n\n# Heading", {"title": "Hello", "author": "World"}],
#   ["# Heading", None],
#   ["---\ntitle: My Post\ntags:\n  - rust\n  - markdown\n---\n", {"title": "My Post", "tags": ["rust", "markdown"]}],
# ])
def test_frontmatter(markdown, expected):
  let result = do markdown | to_markdown() | first() | frontmatter();
  | assert_eq(result, expected)
end

# @parametrize([
#   [42, fn(x): x * 2;, 84],
#   ["hello", fn(x): if (is_string(x)): upcase(x) else: x;, "HELLO"],
#   [None, identity, None],
#   [true, fn(x): if (is_bool(x)): !x else: x;, false],
#   [[], identity, []],
#   [[1, 2, 3], identity, [1, 2, 3]],
#   [[1, 2, 3], fn(x): if (is_number(x)): x * 2 else: x;, [2, 4, 6]],
#   [[[1, 2], [3, 4]], fn(x): if (is_number(x)): x + 10 else: x;, [[11, 12], [13, 14]]],
#   [[[[1]]], fn(x): if (is_number(x)): x + 100 else: x;, [[[101]]]],
#   [[1, "hello", None], identity, [1, "hello", None]],
#   [[2, 4, 6], fn(x): if (is_number(x)): x * -1 else: x;, [-2, -4, -6]],
#   [["a", "b"], fn(x): if (is_string(x)): upcase(x) else: x;, ["A", "B"]],
#   [[true, false], fn(x): if (is_bool(x)): !x else: x;, [false, true]],
#   [[1, 2, 3], fn(x): if (is_number(x)): x * 2 else: x;, [2, 4, 6]],
#   [{}, identity, dict()],
#   [{"a": 1, "b": 2}, fn(x): if (is_number(x)): x * 10 else: x;, {"a": 10, "b": 20}],
#   [{"x": "hello"}, fn(x): if (is_string(x)): upcase(x) else: x;, {"x": "HELLO"}],
#   [{"a": 1, "b": 2}, identity, {"a": 1, "b": 2}],
# ])
def test_walk(value, f, expected):
  let result = walk(value, f)
  | assert_eq(result, expected)
end

def test_walk_markdown():
  # markdown: text leaf — identity preserves text content
  let result1 = do "plain text" | to_markdown() | first() | walk(fn(n): n;) | to_text();
  | assert_eq(result1, "plain text")

  # markdown: heading — identity preserves HTML output
  | let result2 = do "# heading" | to_markdown() | first() | walk(fn(n): n;) | to_html();
  | assert_eq(result2, "<h1>heading</h1>")

  # markdown: h2 — identity preserves depth
  | let result3 = do "## section" | to_markdown() | first() | walk(fn(n): n;) | to_html();
  | assert_eq(result3, "<h2>section</h2>")

  # markdown: demote h1 → h2
  | let result4 = do "# Title" | to_markdown() | first() | walk(fn(n): if (is_h(n)): demote_heading(n) else: n;) | to_html();
  | assert_eq(result4, "<h2>Title</h2>")

  # markdown: promote h2 → h1
  | let result5 = do "## Title" | to_markdown() | first() | walk(fn(n): if (is_h(n)): promote_heading(n) else: n;) | to_html();
  | assert_eq(result5, "<h1>Title</h1>")

  # markdown: node name reflects transformation
  | let result6 = do "# hi" | to_markdown() | first() | walk(fn(n): if (is_h(n)): demote_heading(n) else: n;) | to_md_name();
  | assert_eq(result6, "h2")
end

# @parametrize([[0, "0B"], [500, "500B"], [1500, "1.5KB"], [1000000, "1MB"], [1500000000, "1.5GB"], [-1500, "-1.5KB"]])
def test_human_bytes(value, expected):
  let result = human_bytes(value)
  | assert_eq(result, expected)
end

# @parametrize([[0, "0B"], [500, "500B"], [1536, "1.5K"], [1048576, "1M"], [1610612736, "1.5G"], [-1536, "-1.5K"]])
def test_human_size(value, expected):
  let result = human_size(value)
  | assert_eq(result, expected)
end

def test_assert_type():
  let node = do "# Title" | to_markdown() | first();
  | let result1 = assert_type(node, "h1")
  | assert_eq(result1, node)

  | let result2 = assert_type(node, "h2")
  | assert_eq(is_dict(result2), true)
  | assert_eq(result2["error"], true)
  | assert_eq(result2["range"]["start_line"], 1)

  | let result3 = assert_type("hello", "string")
  | assert_eq(result3, "hello")

  | let result4 = assert_type(42, "string")
  | assert_eq(result4["error"], true)
  | assert_eq(is_none(result4["range"]), true)
end

def test_assert_field():
  let record = {"name": "mq", "kind": "cli"}
  | let result1 = assert_field(record, "name")
  | assert_eq(result1, record)

  | let result2 = assert_field(record, "missing")
  | assert_eq(result2["error"], true)
  | assert_eq(contains(result2["message"], "missing"), true)

  | let result3 = assert_field("not a dict", "name")
  | assert_eq(result3["error"], true)
  | assert_eq(contains(result3["message"], "string"), true)
end

def test_assert_matches():
  let node = do "let x = 1;" | to_markdown() | first();
  | let result1 = assert_matches(node, "^let ")
  | assert_eq(result1, node)

  | let result2 = assert_matches(node, "^fn ")
  | assert_eq(result2["error"], true)
  | assert_eq(result2["range"]["start_line"], 1)

  | let result3 = assert_matches("hello world", "^hello")
  | assert_eq(result3, "hello world")

  | let result4 = assert_matches("hello world", "^bye")
  | assert_eq(result4["error"], true)
end

# -- redact Tests --

def test_redact_key_rule_masks_value():
  assert_eq(
    redact({"user": "alice", "password": "hunter2"}, [{type: "key", pattern: "password"}]),
    {"user": "alice", "password": "[REDACTED]"}
  )
end

def test_redact_key_rule_is_case_insensitive_by_default():
  assert_eq(
    redact({"Password": "hunter2"}, [{type: "key", pattern: "password"}]),
    {"Password": "[REDACTED]"}
  )
end

def test_redact_key_rule_case_sensitive_opt_out():
  assert_eq(
    redact({"Password": "hunter2"}, [{type: "key", pattern: "password", case_insensitive: false}]),
    {"Password": "hunter2"}
  )
end

def test_redact_key_rule_custom_replacement():
  assert_eq(
    redact({"password": "hunter2"}, [{type: "key", pattern: "password", replacement: "***"}]),
    {"password": "***"}
  )
end

def test_redact_key_rule_regex_alternation():
  assert_eq(
    redact({"api_key": "sk-1", "token": "tok-1", "note": "ok"}, [{type: "key", pattern: "api_key|secret|token"}]),
    {"api_key": "[REDACTED]", "token": "[REDACTED]", "note": "ok"}
  )
end

def test_redact_recurses_into_nested_dicts_and_arrays():
  assert_eq(
    redact({"password": "x", "items": [{"password": "y"}, {"other": 1}]}, [{type: "key", pattern: "password"}]),
    {"password": "[REDACTED]", "items": [{"password": "[REDACTED]"}, {"other": 1}]}
  )
end

def test_redact_value_rule_masks_substring_in_string():
  assert_eq(
    redact("token=sk-abc123 (keep this)", [{type: "value", pattern: "sk-[a-z0-9]+", replacement: "[KEY]"}]),
    "token=[KEY] (keep this)"
  )
end

def test_redact_value_rule_applies_inside_dict_values():
  assert_eq(
    redact({"note": "contact a@b.com now"}, [{type: "value", pattern: "[a-z]+@[a-z.]+", replacement: "[EMAIL]"}]),
    {"note": "contact [EMAIL] now"}
  )
end

def test_redact_multiple_value_rules_chain():
  assert_eq(
    redact("a@b.com and 1234-5678-9012-3456", [
      {type: "value", pattern: "[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{4}", replacement: "[CARD]"},
      {type: "value", pattern: "[a-z]+@[a-z.]+", replacement: "[EMAIL]"}
    ]),
    "[EMAIL] and [CARD]"
  )
end

def test_redact_value_rule_no_match_is_unchanged():
  assert_eq(redact("nothing sensitive here", [{type: "value", pattern: "sk-[a-z0-9]+"}]), "nothing sensitive here")
end

def test_redact_non_string_leaves_pass_through():
  assert_eq(redact({"n": 42, "ok": true, "x": None}, [{type: "key", pattern: "nomatch"}]), {"n": 42, "ok": true, "x": None})
end

def test_redact_empty_rules_is_identity():
  assert_eq(redact({"a": 1, "b": [1, "x"]}, []), {"a": 1, "b": [1, "x"]})
  | assert_eq(redact([], []), [])
  | assert_eq(redact({}, []), {})
end

def test_redact_symbol_and_string_keys_both_match():
  assert_eq(redact({a: 1, "b": 2}, [{type: "key", pattern: "a"}]), {"a": "[REDACTED]", "b": 2})
end

def test_redact_value_rule_masks_markdown_text_leaf():
  let node = do "The api key is sk-abc123." | to_markdown() | first();
  | let result = redact(node, [{type: "value", pattern: "sk-[a-z0-9]+", replacement: "[KEY]"}])
  | assert_eq(to_text(result), "The api key is [KEY].")
end

def test_redact_value_rule_masks_markdown_code_inline_leaf():
  let node = do "`sk-abc123`" | to_markdown() | first();
  | let result = redact(node, [{type: "value", pattern: "sk-[a-z0-9]+", replacement: "[KEY]"}])
  | assert_eq(to_text(result), "[KEY]")
end

def test_redact_value_rule_masks_markdown_yaml_frontmatter_leaf():
  let node = do "---\napi_key: sk-abc123\nname: demo\n---\n" | to_markdown() | first();
  | let result = redact(node, [{type: "value", pattern: "sk-[a-z0-9]+", replacement: "[KEY]"}])
  | assert_eq(to_text(result), "api_key: [KEY]\nname: demo")
end

def test_redact_value_rule_recurses_into_markdown_heading_children():
  let node = do "# api key sk-abc123" | to_markdown() | first();
  | let result = redact(node, [{type: "value", pattern: "sk-[a-z0-9]+", replacement: "[KEY]"}])
  | assert_eq(to_html(result), "<h1>api key [KEY]</h1>")
end

def test_redact_key_rule_does_not_apply_to_markdown_nodes():
  let node = do "sk-abc123" | to_markdown() | first();
  | let result = redact(node, [{type: "key", pattern: "sk-[a-z0-9]+"}])
  | assert_eq(to_text(result), "sk-abc123")
end
