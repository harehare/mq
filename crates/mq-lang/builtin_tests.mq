# Array manipulation tests
# @parametrize([
#   [[1, 2, 3], fn(x): x * 2;, [2, 4, 6]],
#   [{"a": 1, "b": 2}, fn(x): [x[0], x[1] * 2];, {"a": 2, "b": 4}],
#   [None, fn(x): [x[0], x[1] * 2];, None],
# ])
def test_map(value, f, expected):
  let result = map(value, f)
  | assert_eq(result, expected)
end

